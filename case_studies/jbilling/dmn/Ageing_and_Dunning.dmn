<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_Ageing_and_Dunning" name="Ageing and Dunning" namespace="urn:bridge:jbilling:Definitions_Ageing_and_Dunning"><decision id="Decision_IsAgeingRequired" name="Is Ageing Required"><decisionTable id="Decision_IsAgeingRequired_Table" hitPolicy="FIRST"><input id="Decision_IsAgeingRequired_Input_1" label="Expiry Date"><inputExpression id="Decision_IsAgeingRequired_InputExpr_1" typeRef="date"><text>expiryDate</text></inputExpression></input><output id="Decision_IsAgeingRequired_Output_1" label="Ageing Required" name="ageingRequired" typeRef="boolean" /><rule id="Decision_IsAgeingRequired_Rule_1"><description>BasicAgeingTask.java L239-243 (mirrored in BusinessDayAgeingTask.java L89-93): expiryDate.equals(today) || expiryDate.before(today) -&gt; ageing required (note: &lt;=, i.e. equals-or-before)</description><inputEntry id="Decision_IsAgeingRequired_Rule_1_InEntry_1"><text>&lt;= today()</text></inputEntry><outputEntry id="Decision_IsAgeingRequired_Rule_1_OutEntry_1"><text>true</text></outputEntry></rule><rule id="Decision_IsAgeingRequired_Rule_2"><description>BasicAgeingTask.java L245-247 (mirrored in BusinessDayAgeingTask.java L95-97): otherwise not yet required</description><inputEntry id="Decision_IsAgeingRequired_Rule_2_InEntry_1"><text>-</text></inputEntry><outputEntry id="Decision_IsAgeingRequired_Rule_2_OutEntry_1"><text>false</text></outputEntry></rule></decisionTable></decision><decision id="Decision_InvoiceOverdue" name="Invoice Overdue Check"><decisionTable id="Decision_InvoiceOverdue_Table" hitPolicy="FIRST"><input id="Decision_InvoiceOverdue_Input_1" label="Invoice Due Date Plus Grace"><inputExpression id="Decision_InvoiceOverdue_InputExpr_1" typeRef="date"><text>dueDatePlusGrace</text></inputExpression></input><output id="Decision_InvoiceOverdue_Output_1" label="Invoice Overdue" name="invoiceOverdue" typeRef="boolean" /><rule id="Decision_InvoiceOverdue_Rule_1"><description>BasicAgeingTask.java L211-215 (mirrored in BusinessDayAgeingTask.java L69-73): dueDate+gracePeriod.before(today) -&gt; overdue (strict &lt;, unlike the &lt;= used in Is Ageing Required -- a step that expires exactly "today" is due for advancement, but an invoice due exactly "today" is NOT yet overdue -- a real one-day boundary inconsistency between the two checks)</description><inputEntry id="Decision_InvoiceOverdue_Rule_1_InEntry_1"><text>&lt; today()</text></inputEntry><outputEntry id="Decision_InvoiceOverdue_Rule_1_OutEntry_1"><text>true</text></outputEntry></rule><rule id="Decision_InvoiceOverdue_Rule_2"><description>BasicAgeingTask.java L217-219 (mirrored in BusinessDayAgeingTask.java L75-77): otherwise not overdue</description><inputEntry id="Decision_InvoiceOverdue_Rule_2_InEntry_1"><text>-</text></inputEntry><outputEntry id="Decision_InvoiceOverdue_Rule_2_OutEntry_1"><text>false</text></outputEntry></rule></decisionTable></decision><decision id="Decision_AgeingStepAdvancement" name="Ageing Step Advancement"><informationRequirement id="InfoReq_1"><requiredDecision href="#Decision_IsAgeingRequired" /></informationRequirement><decisionTable id="Decision_AgeingStepAdvancement_Table" hitPolicy="FIRST"><input id="Decision_AgeingStepAdvancement_Input_1" label="Current Status Is Active"><inputExpression id="Decision_AgeingStepAdvancement_InputExpr_1" typeRef="boolean"><text>currentStatusIsActive</text></inputExpression></input><input id="Decision_AgeingStepAdvancement_Input_2" label="Ageing Step Config Found"><inputExpression id="Decision_AgeingStepAdvancement_InputExpr_2" typeRef="boolean"><text>ageingStepConfigFound</text></inputExpression></input><input id="Decision_AgeingStepAdvancement_Input_3" label="Ageing Required"><inputExpression id="Decision_AgeingStepAdvancement_InputExpr_3" typeRef="boolean"><text>ageingRequired</text></inputExpression></input><output id="Decision_AgeingStepAdvancement_Output_1" label="Advance To Next Step" name="advanceToNextStep" typeRef="boolean" /><output id="Decision_AgeingStepAdvancement_Output_2" label="Advancement Reason" name="advancementReason" typeRef="string" /><rule id="Decision_AgeingStepAdvancement_Rule_1"><description>L157-159: currentStatusId==STATUS_ACTIVE -&gt; nextStatus = getNextAgeingStep(steps, ACTIVE) (send welcome step)</description><inputEntry id="Decision_AgeingStepAdvancement_Rule_1_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_AgeingStepAdvancement_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStepAdvancement_Rule_1_InEntry_3"><text>-</text></inputEntry><outputEntry id="Decision_AgeingStepAdvancement_Rule_1_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_AgeingStepAdvancement_Rule_1_OutEntry_2"><text>"INITIAL_STEP"</text></outputEntry></rule><rule id="Decision_AgeingStepAdvancement_Rule_2"><description>L163,172-177: ageingStep lookup returns null (removed/bad config) -&gt; force-advance to next step regardless of elapsed time, logged as a warning</description><inputEntry id="Decision_AgeingStepAdvancement_Rule_2_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_AgeingStepAdvancement_Rule_2_InEntry_2"><text>false</text></inputEntry><inputEntry id="Decision_AgeingStepAdvancement_Rule_2_InEntry_3"><text>-</text></inputEntry><outputEntry id="Decision_AgeingStepAdvancement_Rule_2_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_AgeingStepAdvancement_Rule_2_OutEntry_2"><text>"INVALID_STEP_RECOVERY"</text></outputEntry></rule><rule id="Decision_AgeingStepAdvancement_Rule_3"><description>L163-171 (isAgeingRequired call at L167): step config found and user has spent &gt;= configured days in it -&gt; advance</description><inputEntry id="Decision_AgeingStepAdvancement_Rule_3_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_AgeingStepAdvancement_Rule_3_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_AgeingStepAdvancement_Rule_3_InEntry_3"><text>true</text></inputEntry><outputEntry id="Decision_AgeingStepAdvancement_Rule_3_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_AgeingStepAdvancement_Rule_3_OutEntry_2"><text>"STEP_EXPIRED"</text></outputEntry></rule><rule id="Decision_AgeingStepAdvancement_Rule_4"><description>L165-171 implicit else: step config found but not yet expired -&gt; nextStatus stays null, no advancement</description><inputEntry id="Decision_AgeingStepAdvancement_Rule_4_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_AgeingStepAdvancement_Rule_4_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_AgeingStepAdvancement_Rule_4_InEntry_3"><text>false</text></inputEntry><outputEntry id="Decision_AgeingStepAdvancement_Rule_4_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_AgeingStepAdvancement_Rule_4_OutEntry_2"><text>"NO_ACTION"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_AgeingStatusChangeOrderAction" name="Ageing Status Change Order Action"><informationRequirement id="InfoReq_2"><requiredDecision href="#Decision_AgeingStepAdvancement" /></informationRequirement><decisionTable id="Decision_AgeingStatusChangeOrderAction_Table" hitPolicy="FIRST"><input id="Decision_AgeingStatusChangeOrderAction_Input_1" label="New Status Is Deleted"><inputExpression id="Decision_AgeingStatusChangeOrderAction_InputExpr_1" typeRef="boolean"><text>newStatusIsDeleted</text></inputExpression></input><input id="Decision_AgeingStatusChangeOrderAction_Input_2" label="Old Status Can Login"><inputExpression id="Decision_AgeingStatusChangeOrderAction_InputExpr_2" typeRef="boolean"><text>oldStatusCanLogin</text></inputExpression></input><input id="Decision_AgeingStatusChangeOrderAction_Input_3" label="New Status Can Login"><inputExpression id="Decision_AgeingStatusChangeOrderAction_InputExpr_3" typeRef="boolean"><text>newStatusCanLogin</text></inputExpression></input><output id="Decision_AgeingStatusChangeOrderAction_Output_1" label="Order Action" name="orderAction" typeRef="string" /><rule id="Decision_AgeingStatusChangeOrderAction_Rule_1"><description>L336-340: new status == STATUS_DELETED -&gt; new UserBL(user.getId()).delete(executorId); return (terminal, orders untouched here)</description><inputEntry id="Decision_AgeingStatusChangeOrderAction_Rule_1_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_AgeingStatusChangeOrderAction_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStatusChangeOrderAction_Rule_1_InEntry_3"><text>-</text></inputEntry><outputEntry id="Decision_AgeingStatusChangeOrderAction_Rule_1_OutEntry_1"><text>"DELETE_USER"</text></outputEntry></rule><rule id="Decision_AgeingStatusChangeOrderAction_Rule_2"><description>L344-353: couldLogin (old status canLogin==1) transitions to newStatus.canLogin==0 -&gt; every ACTIVE order for the user is set to ORDER_STATUS_SUSPENDED_AGEING</description><inputEntry id="Decision_AgeingStatusChangeOrderAction_Rule_2_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_AgeingStatusChangeOrderAction_Rule_2_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_AgeingStatusChangeOrderAction_Rule_2_InEntry_3"><text>false</text></inputEntry><outputEntry id="Decision_AgeingStatusChangeOrderAction_Rule_2_OutEntry_1"><text>"SUSPEND_ACTIVE_ORDERS"</text></outputEntry></rule><rule id="Decision_AgeingStatusChangeOrderAction_Rule_3"><description>L357-366: !couldLogin transitions to newStatus.canLogin==1 -&gt; every order in ORDER_STATUS_SUSPENDED_AGEING is set back to ORDER_STATUS_ACTIVE</description><inputEntry id="Decision_AgeingStatusChangeOrderAction_Rule_3_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_AgeingStatusChangeOrderAction_Rule_3_InEntry_2"><text>false</text></inputEntry><inputEntry id="Decision_AgeingStatusChangeOrderAction_Rule_3_InEntry_3"><text>true</text></inputEntry><outputEntry id="Decision_AgeingStatusChangeOrderAction_Rule_3_OutEntry_1"><text>"REACTIVATE_SUSPENDED_ORDERS"</text></outputEntry></rule><rule id="Decision_AgeingStatusChangeOrderAction_Rule_4"><description>L342-366 implicit: neither the suspend nor reactivate canLogin-transition condition matches -&gt; no order-status changes; only the callback/notification fire</description><inputEntry id="Decision_AgeingStatusChangeOrderAction_Rule_4_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_AgeingStatusChangeOrderAction_Rule_4_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStatusChangeOrderAction_Rule_4_InEntry_3"><text>-</text></inputEntry><outputEntry id="Decision_AgeingStatusChangeOrderAction_Rule_4_OutEntry_1"><text>"NO_ORDER_ACTION"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_AgeingStepConfigValidation" name="Ageing Step Config Validation"><decisionTable id="Decision_AgeingStepConfigValidation_Table" hitPolicy="FIRST"><input id="Decision_AgeingStepConfigValidation_Input_1" label="Status Is Active"><inputExpression id="Decision_AgeingStepConfigValidation_InputExpr_1" typeRef="boolean"><text>statusIsActive</text></inputExpression></input><input id="Decision_AgeingStepConfigValidation_Input_2" label="Status Is Deleted"><inputExpression id="Decision_AgeingStepConfigValidation_InputExpr_2" typeRef="boolean"><text>statusIsDeleted</text></inputExpression></input><input id="Decision_AgeingStepConfigValidation_Input_3" label="Is Last Selected Step"><inputExpression id="Decision_AgeingStepConfigValidation_InputExpr_3" typeRef="boolean"><text>isLastSelectedStep</text></inputExpression></input><input id="Decision_AgeingStepConfigValidation_Input_4" label="In Use"><inputExpression id="Decision_AgeingStepConfigValidation_InputExpr_4" typeRef="boolean"><text>inUse</text></inputExpression></input><input id="Decision_AgeingStepConfigValidation_Input_5" label="Welcome Message Present"><inputExpression id="Decision_AgeingStepConfigValidation_InputExpr_5" typeRef="boolean"><text>welcomeMessagePresent</text></inputExpression></input><input id="Decision_AgeingStepConfigValidation_Input_6" label="Days"><inputExpression id="Decision_AgeingStepConfigValidation_InputExpr_6" typeRef="number"><text>days</text></inputExpression></input><output id="Decision_AgeingStepConfigValidation_Output_1" label="Validation Result" name="validationResult" typeRef="string" /><rule id="Decision_AgeingStepConfigValidation_Rule_1"><description>AgeingBL.java L198: if (!steps[f].getInUse()) the entire validation block (L199-227) is skipped -&gt; row trivially passes</description><inputEntry id="Decision_AgeingStepConfigValidation_Rule_1_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_1_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_1_InEntry_4"><text>false</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_1_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_1_InEntry_6"><text>-</text></inputEntry><outputEntry id="Decision_AgeingStepConfigValidation_Rule_1_OutEntry_1"><text>"OK"</text></outputEntry></rule><rule id="Decision_AgeingStepConfigValidation_Rule_2"><description>AgeingBL.java L200-205: in-use, not the DELETED step, welcomeMessage is null -&gt; throws config.ageing.error.null.message</description><inputEntry id="Decision_AgeingStepConfigValidation_Rule_2_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_2_InEntry_2"><text>false</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_2_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_2_InEntry_4"><text>true</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_2_InEntry_5"><text>false</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_2_InEntry_6"><text>-</text></inputEntry><outputEntry id="Decision_AgeingStepConfigValidation_Rule_2_OutEntry_1"><text>"ERROR_NULL_WELCOME_MESSAGE"</text></outputEntry></rule><rule id="Decision_AgeingStepConfigValidation_Rule_3"><description>AgeingBL.java L208-216: in-use, not ACTIVE, not DELETED, not last-selected step, days &lt;= 0 -&gt; throws config.ageing.error.zero.days</description><inputEntry id="Decision_AgeingStepConfigValidation_Rule_3_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_3_InEntry_2"><text>false</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_3_InEntry_3"><text>false</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_3_InEntry_4"><text>true</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_3_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_3_InEntry_6"><text>&lt;= 0</text></inputEntry><outputEntry id="Decision_AgeingStepConfigValidation_Rule_3_OutEntry_1"><text>"ERROR_ZERO_DAYS"</text></outputEntry></rule><rule id="Decision_AgeingStepConfigValidation_Rule_4"><description>AgeingBL.java L220-225: this row is the last-selected (highest-index in-use) step and days &gt; 0 -&gt; throws config.ageing.error.lastDay</description><inputEntry id="Decision_AgeingStepConfigValidation_Rule_4_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_4_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_4_InEntry_3"><text>true</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_4_InEntry_4"><text>true</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_4_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_4_InEntry_6"><text>&gt; 0</text></inputEntry><outputEntry id="Decision_AgeingStepConfigValidation_Rule_4_OutEntry_1"><text>"ERROR_LAST_STEP_DAYS_MUST_BE_ZERO"</text></outputEntry></rule><rule id="Decision_AgeingStepConfigValidation_Rule_5"><description>AgeingBL.java L226: last-selected step with days &lt;= 0 is silently normalized to days=0; every other combination falls through with no exception</description><inputEntry id="Decision_AgeingStepConfigValidation_Rule_5_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_5_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_5_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_5_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_5_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_AgeingStepConfigValidation_Rule_5_InEntry_6"><text>-</text></inputEntry><outputEntry id="Decision_AgeingStepConfigValidation_Rule_5_OutEntry_1"><text>"OK"</text></outputEntry></rule></decisionTable></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_Ageing_and_Dunning_Diagram"><dmndi:DMNShape id="Decision_IsAgeingRequired_Shape" dmnElementRef="Decision_IsAgeingRequired"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_InvoiceOverdue_Shape" dmnElementRef="Decision_InvoiceOverdue"><dc:Bounds x="60" y="260" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_AgeingStepAdvancement_Shape" dmnElementRef="Decision_AgeingStepAdvancement"><dc:Bounds x="370" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_AgeingStatusChangeOrderAction_Shape" dmnElementRef="Decision_AgeingStatusChangeOrderAction"><dc:Bounds x="680" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_AgeingStepConfigValidation_Shape" dmnElementRef="Decision_AgeingStepConfigValidation"><dc:Bounds x="60" y="460" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNEdge id="Edge_1" dmnElementRef="InfoReq_1"><di:waypoint x="280" y="105" /><di:waypoint x="370" y="105" /></dmndi:DMNEdge><dmndi:DMNEdge id="Edge_2" dmnElementRef="InfoReq_2"><di:waypoint x="590" y="105" /><di:waypoint x="680" y="105" /></dmndi:DMNEdge></dmndi:DMNDiagram></dmndi:DMNDI></definitions>