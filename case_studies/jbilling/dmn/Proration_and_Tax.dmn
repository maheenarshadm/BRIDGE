<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_Proration_and_Tax" name="Proration and Tax" namespace="urn:bridge:jbilling:Definitions_Proration_and_Tax"><decision id="Decision_CycleStartSource" name="Cycle Start Source"><decisionTable id="Decision_CycleStartSource_Table" hitPolicy="FIRST"><input id="Decision_CycleStartSource_Input_1" label="Order Has Next Billable Day Set"><inputExpression id="Decision_CycleStartSource_InputExpr_1" typeRef="boolean"><text>hasNextBillableDay</text></inputExpression></input><input id="Decision_CycleStartSource_Input_2" label="Order Has Cycle Starts Date Set"><inputExpression id="Decision_CycleStartSource_InputExpr_2" typeRef="boolean"><text>hasCycleStarts</text></inputExpression></input><output id="Decision_CycleStartSource_Output_1" label="Resolved Cycle Start Date Source" name="cycleStartDateSource" typeRef="string" /><rule id="Decision_CycleStartSource_Rule_1"><description>ProRateOrderPeriodTask.java L78-79: order.getNextBillableDay() != null -&gt; use it as the cycle start</description><inputEntry id="Decision_CycleStartSource_Rule_1_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_CycleStartSource_Rule_1_InEntry_2"><text>-</text></inputEntry><outputEntry id="Decision_CycleStartSource_Rule_1_OutEntry_1"><text>"purchase_order.next_billable_day"</text></outputEntry></rule><rule id="Decision_CycleStartSource_Rule_2"><description>L80-81: else if order.getCycleStarts() != null -&gt; use the order's cycle-start date instead (getter name is plural, column is singular -- a real naming mismatch)</description><inputEntry id="Decision_CycleStartSource_Rule_2_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_CycleStartSource_Rule_2_InEntry_2"><text>true</text></inputEntry><outputEntry id="Decision_CycleStartSource_Rule_2_OutEntry_1"><text>"purchase_order.cycle_start"</text></outputEntry></rule><rule id="Decision_CycleStartSource_Rule_3"><description>L82-83: else fall back to the periodStart parameter passed in by the caller</description><inputEntry id="Decision_CycleStartSource_Rule_3_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_CycleStartSource_Rule_3_InEntry_2"><text>false</text></inputEntry><outputEntry id="Decision_CycleStartSource_Rule_3_OutEntry_1"><text>"periodStart (caller-supplied billing-period start parameter)"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_DailyProRateAmount" name="Daily Pro-Rate Amount"><decisionTable id="Decision_DailyProRateAmount_Table" hitPolicy="FIRST"><input id="Decision_DailyProRateAmount_Input_1" label="Days In Cycle"><inputExpression id="Decision_DailyProRateAmount_InputExpr_1" typeRef="number"><text>daysInCycle</text></inputExpression></input><input id="Decision_DailyProRateAmount_Input_2" label="Days In Period"><inputExpression id="Decision_DailyProRateAmount_InputExpr_2" typeRef="number"><text>daysInPeriod</text></inputExpression></input><input id="Decision_DailyProRateAmount_Input_3" label="Full Price"><inputExpression id="Decision_DailyProRateAmount_InputExpr_3" typeRef="number"><text>fullPrice</text></inputExpression></input><output id="Decision_DailyProRateAmount_Output_1" label="Prorated Amount" name="proratedAmount" typeRef="number" /><rule id="Decision_DailyProRateAmount_Rule_1"><description>DailyProRateCompositionTask.java L45-47: daysInCycle == 0 means this is a one-time order amount, not a real period of time -&gt; return fullPrice unchanged</description><inputEntry id="Decision_DailyProRateAmount_Rule_1_InEntry_1"><text>0</text></inputEntry><inputEntry id="Decision_DailyProRateAmount_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_DailyProRateAmount_Rule_1_InEntry_3"><text>-</text></inputEntry><outputEntry id="Decision_DailyProRateAmount_Rule_1_OutEntry_1"><text>fullPrice</text></outputEntry></rule><rule id="Decision_DailyProRateAmount_Rule_2"><description>L50-52: daysInCycle == daysInPeriod -&gt; not a fraction of a period, don't prorate, return fullPrice unchanged (cell tests daysInCycle for equality against the daysInPeriod input variable)</description><inputEntry id="Decision_DailyProRateAmount_Rule_2_InEntry_1"><text>daysInPeriod</text></inputEntry><inputEntry id="Decision_DailyProRateAmount_Rule_2_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_DailyProRateAmount_Rule_2_InEntry_3"><text>-</text></inputEntry><outputEntry id="Decision_DailyProRateAmount_Rule_2_OutEntry_1"><text>fullPrice</text></outputEntry></rule><rule id="Decision_DailyProRateAmount_Rule_3"><description>L54-57: otherwise divide fullPrice by daysInCycle to get a one-day rate, then multiply by daysInPeriod</description><inputEntry id="Decision_DailyProRateAmount_Rule_3_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_DailyProRateAmount_Rule_3_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_DailyProRateAmount_Rule_3_InEntry_3"><text>-</text></inputEntry><outputEntry id="Decision_DailyProRateAmount_Rule_3_OutEntry_1"><text>(fullPrice / daysInCycle) * daysInPeriod</text></outputEntry></rule></decisionTable></decision><decision id="Decision_TaxCalculationNeeded" name="Tax Calculation Needed"><decisionTable id="Decision_TaxCalculationNeeded_Table" hitPolicy="FIRST"><input id="Decision_TaxCalculationNeeded_Input_1" label="Customer-Exemption Custom Field Configured"><inputExpression id="Decision_TaxCalculationNeeded_InputExpr_1" typeRef="boolean"><text>customContactFieldConfigured</text></inputExpression></input><input id="Decision_TaxCalculationNeeded_Input_2" label="Customer Has Primary Contact"><inputExpression id="Decision_TaxCalculationNeeded_InputExpr_2" typeRef="boolean"><text>primaryContactFound</text></inputExpression></input><input id="Decision_TaxCalculationNeeded_Input_3" label="Matching Contact Field Value"><inputExpression id="Decision_TaxCalculationNeeded_InputExpr_3" typeRef="string"><text>matchingFieldValue</text></inputExpression><inputValues id="Decision_TaxCalculationNeeded_InputVals_3"><text>"EXEMPT_VALUE","OTHER"</text></inputValues></input><output id="Decision_TaxCalculationNeeded_Output_1" label="Tax Calculation Needed" name="taxCalculationNeeded" typeRef="boolean" /><rule id="Decision_TaxCalculationNeeded_Rule_1"><description>SimpleTaxCompositionTask.java L161-163: no custom_contact_field_id plugin parameter configured -&gt; tax is always calculated (no exemption mechanism active)</description><inputEntry id="Decision_TaxCalculationNeeded_Rule_1_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_TaxCalculationNeeded_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_TaxCalculationNeeded_Rule_1_InEntry_3"><text>-</text></inputEntry><outputEntry id="Decision_TaxCalculationNeeded_Rule_1_OutEntry_1"><text>true</text></outputEntry></rule><rule id="Decision_TaxCalculationNeeded_Rule_2"><description>L164-167: field configured but no primary contact found for the customer -&gt; tax still calculated (fails open)</description><inputEntry id="Decision_TaxCalculationNeeded_Rule_2_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_TaxCalculationNeeded_Rule_2_InEntry_2"><text>false</text></inputEntry><inputEntry id="Decision_TaxCalculationNeeded_Rule_2_InEntry_3"><text>-</text></inputEntry><outputEntry id="Decision_TaxCalculationNeeded_Rule_2_OutEntry_1"><text>true</text></outputEntry></rule><rule id="Decision_TaxCalculationNeeded_Rule_3"><description>L169-174: a contact field of the configured type has content case-insensitively equal to "yes"/"true" -&gt; customer is tax-exempt</description><inputEntry id="Decision_TaxCalculationNeeded_Rule_3_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_TaxCalculationNeeded_Rule_3_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_TaxCalculationNeeded_Rule_3_InEntry_3"><text>"EXEMPT_VALUE"</text></inputEntry><outputEntry id="Decision_TaxCalculationNeeded_Rule_3_OutEntry_1"><text>false</text></outputEntry></rule><rule id="Decision_TaxCalculationNeeded_Rule_4"><description>L169-178: no matching exempt-value contact field found -&gt; falls through to the default 'true' at L178</description><inputEntry id="Decision_TaxCalculationNeeded_Rule_4_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_TaxCalculationNeeded_Rule_4_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_TaxCalculationNeeded_Rule_4_InEntry_3"><text>"OTHER"</text></inputEntry><outputEntry id="Decision_TaxCalculationNeeded_Rule_4_OutEntry_1"><text>true</text></outputEntry></rule></decisionTable></decision><decision id="Decision_TaxCalculationMode" name="Tax Calculation Mode"><informationRequirement id="InfoReq_1"><requiredDecision href="#Decision_TaxCalculationNeeded" /></informationRequirement><decisionTable id="Decision_TaxCalculationMode_Table" hitPolicy="UNIQUE"><input id="Decision_TaxCalculationMode_Input_1" label="Tax Item Has Percentage Set"><inputExpression id="Decision_TaxCalculationMode_InputExpr_1" typeRef="boolean"><text>taxItemHasPercentage</text></inputExpression></input><output id="Decision_TaxCalculationMode_Output_1" label="Tax Calculation Mode" name="taxCalculationMode" typeRef="string" /><rule id="Decision_TaxCalculationMode_Rule_1"><description>SimpleTaxCompositionTask.java L101: taxItem.getPercentage() != null -&gt; tax calculated as a percentage of the invoice total</description><inputEntry id="Decision_TaxCalculationMode_Rule_1_InEntry_1"><text>true</text></inputEntry><outputEntry id="Decision_TaxCalculationMode_Rule_1_OutEntry_1"><text>"PERCENTAGE"</text></outputEntry></rule><rule id="Decision_TaxCalculationMode_Rule_2"><description>L145-146: taxItem.getPercentage() is null -&gt; tax item treated as a flat additional charge, priced via item_price</description><inputEntry id="Decision_TaxCalculationMode_Rule_2_InEntry_1"><text>false</text></inputEntry><outputEntry id="Decision_TaxCalculationMode_Rule_2_OutEntry_1"><text>"FLAT"</text></outputEntry></rule></decisionTable></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_Proration_and_Tax_Diagram"><dmndi:DMNShape id="Decision_CycleStartSource_Shape" dmnElementRef="Decision_CycleStartSource"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_DailyProRateAmount_Shape" dmnElementRef="Decision_DailyProRateAmount"><dc:Bounds x="60" y="260" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_TaxCalculationNeeded_Shape" dmnElementRef="Decision_TaxCalculationNeeded"><dc:Bounds x="60" y="460" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_TaxCalculationMode_Shape" dmnElementRef="Decision_TaxCalculationMode"><dc:Bounds x="370" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNEdge id="Edge_1" dmnElementRef="InfoReq_1"><di:waypoint x="280" y="505" /><di:waypoint x="370" y="105" /></dmndi:DMNEdge></dmndi:DMNDiagram></dmndi:DMNDI></definitions>