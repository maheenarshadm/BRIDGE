<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_Currency_Exchange_Rules" name="Currency Exchange Rules" namespace="urn:bridge:jbilling:Definitions_Currency_Exchange_Rules"><decision id="Decision_CurrencyExchangeRateSource" name="Currency Exchange Rate Source"><decisionTable id="Decision_CurrencyExchangeRateSource_Table" hitPolicy="FIRST"><input id="Decision_CurrencyExchangeRateSource_Input_1" label="Entity-Specific Exchange Rate Exists"><inputExpression id="Decision_CurrencyExchangeRateSource_InputExpr_1" typeRef="boolean"><text>hasEntitySpecificExchange</text></inputExpression></input><input id="Decision_CurrencyExchangeRateSource_Input_2" label="System Default Exchange Rate Exists (entity_id = 0)"><inputExpression id="Decision_CurrencyExchangeRateSource_InputExpr_2" typeRef="boolean"><text>hasSystemDefaultExchange</text></inputExpression></input><output id="Decision_CurrencyExchangeRateSource_Output_1" label="Exchange Rate Source" name="exchangeRateSource" typeRef="string" /><rule id="Decision_CurrencyExchangeRateSource_Rule_1"><description>CurrencyBL.java L325-326: a currency_exchange row scoped to this entity exists -&gt; use it</description><inputEntry id="Decision_CurrencyExchangeRateSource_Rule_1_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_CurrencyExchangeRateSource_Rule_1_InEntry_2"><text>-</text></inputEntry><outputEntry id="Decision_CurrencyExchangeRateSource_Rule_1_OutEntry_1"><text>"ENTITY_SPECIFIC"</text></outputEntry></rule><rule id="Decision_CurrencyExchangeRateSource_Rule_2"><description>L327-329: no entity-specific row -&gt; fall back to the currency_exchange row for the sentinel entity_id = 0 ("0 is the default", per the code comment)</description><inputEntry id="Decision_CurrencyExchangeRateSource_Rule_2_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_CurrencyExchangeRateSource_Rule_2_InEntry_2"><text>true</text></inputEntry><outputEntry id="Decision_CurrencyExchangeRateSource_Rule_2_OutEntry_1"><text>"SYSTEM_DEFAULT"</text></outputEntry></rule><rule id="Decision_CurrencyExchangeRateSource_Rule_3"><description>L330-333: neither an entity-specific nor a system-default (entity_id=0) row exists -&gt; throws SessionInternalError</description><inputEntry id="Decision_CurrencyExchangeRateSource_Rule_3_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_CurrencyExchangeRateSource_Rule_3_InEntry_2"><text>false</text></inputEntry><outputEntry id="Decision_CurrencyExchangeRateSource_Rule_3_OutEntry_1"><text>"ERROR_NO_RATE"</text></outputEntry></rule></decisionTable></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_Currency_Exchange_Rules_Diagram"><dmndi:DMNShape id="Decision_CurrencyExchangeRateSource_Shape" dmnElementRef="Decision_CurrencyExchangeRateSource"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape></dmndi:DMNDiagram></dmndi:DMNDI></definitions>