<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_Payment_Authorization_and_Blacklist" name="Payment Authorization and Blacklist" namespace="urn:bridge:jbilling:Definitions_Payment_Authorization_and_Blacklist"><decision id="Decision_PaymentOutcomeResolution" name="Payment Outcome Resolution"><decisionTable id="Decision_PaymentOutcomeResolution_Table" hitPolicy="FIRST"><input id="Decision_PaymentOutcomeResolution_Input_1" label="Processor Unavailable After All Tasks Tried"><inputExpression id="Decision_PaymentOutcomeResolution_InputExpr_1" typeRef="boolean"><text>processorUnavailable</text></inputExpression></input><input id="Decision_PaymentOutcomeResolution_Input_2" label="Last Task Payment Result Id (1=OK,2=FAIL,3=UNAVAILABLE,4=ENTERED)"><inputExpression id="Decision_PaymentOutcomeResolution_InputExpr_2" typeRef="number"><text>paymentResultId</text></inputExpression></input><output id="Decision_PaymentOutcomeResolution_Output_1" label="Resolved Result Code" name="resultCode" typeRef="number" /><rule id="Decision_PaymentOutcomeResolution_Rule_1"><description>PaymentBL.java L340-341: if the while-loop over pluggable payment tasks exits with processorUnavailable still true, the outcome is forced to RESULT_UNAVAILABLE (3), overriding whatever result code the last attempted task left on the payment</description><inputEntry id="Decision_PaymentOutcomeResolution_Rule_1_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_PaymentOutcomeResolution_Rule_1_InEntry_2"><text>-</text></inputEntry><outputEntry id="Decision_PaymentOutcomeResolution_Rule_1_OutEntry_1"><text>3</text></outputEntry></rule><rule id="Decision_PaymentOutcomeResolution_Rule_2"><description>PaymentBL.java L342-344: otherwise (a task actually completed, success or decline) the outcome is exactly the last task's payment result id, passed through unchanged</description><inputEntry id="Decision_PaymentOutcomeResolution_Rule_2_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_PaymentOutcomeResolution_Rule_2_InEntry_2"><text>-</text></inputEntry><outputEntry id="Decision_PaymentOutcomeResolution_Rule_2_OutEntry_1"><text>paymentResultId</text></outputEntry></rule></decisionTable></decision><decision id="Decision_PaymentBalanceAssignment" name="Payment Balance Assignment"><informationRequirement id="InfoReq_1"><requiredDecision href="#Decision_PaymentOutcomeResolution" /></informationRequirement><decisionTable id="Decision_PaymentBalanceAssignment_Table" hitPolicy="FIRST"><input id="Decision_PaymentBalanceAssignment_Input_1" label="Resolved Result Code"><inputExpression id="Decision_PaymentBalanceAssignment_InputExpr_1" typeRef="number"><text>resultCode</text></inputExpression></input><input id="Decision_PaymentBalanceAssignment_Input_2" label="Payment Amount"><inputExpression id="Decision_PaymentBalanceAssignment_InputExpr_2" typeRef="number"><text>paymentAmount</text></inputExpression></input><output id="Decision_PaymentBalanceAssignment_Output_1" label="Balance" name="balance" typeRef="number" /><rule id="Decision_PaymentBalanceAssignment_Rule_1"><description>PaymentBL.java L347-348: if RESULT_OK or RESULT_ENTERED, payment.setBalance(payment.getAmount()) -- a successful or manually-entered payment carries its full amount as available balance</description><inputEntry id="Decision_PaymentBalanceAssignment_Rule_1_InEntry_1"><text>1,4</text></inputEntry><inputEntry id="Decision_PaymentBalanceAssignment_Rule_1_InEntry_2"><text>-</text></inputEntry><outputEntry id="Decision_PaymentBalanceAssignment_Rule_1_OutEntry_1"><text>paymentAmount</text></outputEntry></rule><rule id="Decision_PaymentBalanceAssignment_Rule_2"><description>PaymentBL.java L349-350: else payment.setBalance(ZERO) -- a failed or processor-unavailable payment has no usable balance</description><inputEntry id="Decision_PaymentBalanceAssignment_Rule_2_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_PaymentBalanceAssignment_Rule_2_InEntry_2"><text>-</text></inputEntry><outputEntry id="Decision_PaymentBalanceAssignment_Rule_2_OutEntry_1"><text>0</text></outputEntry></rule></decisionTable></decision><decision id="Decision_BlacklistFilterEnabled" name="Blacklist Filter Enabled"><decisionTable id="Decision_BlacklistFilterEnabled_Table" hitPolicy="UNIQUE"><input id="Decision_BlacklistFilterEnabled_Input_1" label="Blacklist Plug-in Id (entity preference PREFERENCE_USE_BLACKLIST=43)"><inputExpression id="Decision_BlacklistFilterEnabled_InputExpr_1" typeRef="number"><text>blacklistPluginId</text></inputExpression></input><output id="Decision_BlacklistFilterEnabled_Output_1" label="Blacklist Filtering Enabled" name="blacklistEnabled" typeRef="boolean" /><rule id="Decision_BlacklistFilterEnabled_Rule_1"><description>BlacklistBL.java L129-131 (return getBlacklistPluginId(entityId) != 0) and L178-181: plug-in id 0 means no payment-filter plug-in was ever configured for the entity, so filtering is off</description><inputEntry id="Decision_BlacklistFilterEnabled_Rule_1_InEntry_1"><text>0</text></inputEntry><outputEntry id="Decision_BlacklistFilterEnabled_Rule_1_OutEntry_1"><text>false</text></outputEntry></rule><rule id="Decision_BlacklistFilterEnabled_Rule_2"><description>BlacklistBL.java L129-131: any non-zero plug-in id (a real row found via PluggableTaskDAS) means the blacklist/payment filter plug-in is active for the entity</description><inputEntry id="Decision_BlacklistFilterEnabled_Rule_2_InEntry_1"><text>!= 0</text></inputEntry><outputEntry id="Decision_BlacklistFilterEnabled_Rule_2_OutEntry_1"><text>true</text></outputEntry></rule></decisionTable></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_Payment_Authorization_and_Blacklist_Diagram"><dmndi:DMNShape id="Decision_PaymentOutcomeResolution_Shape" dmnElementRef="Decision_PaymentOutcomeResolution"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_PaymentBalanceAssignment_Shape" dmnElementRef="Decision_PaymentBalanceAssignment"><dc:Bounds x="370" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_BlacklistFilterEnabled_Shape" dmnElementRef="Decision_BlacklistFilterEnabled"><dc:Bounds x="60" y="260" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNEdge id="Edge_1" dmnElementRef="InfoReq_1"><di:waypoint x="280" y="105" /><di:waypoint x="370" y="105" /></dmndi:DMNEdge></dmndi:DMNDiagram></dmndi:DMNDI></definitions>