<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_Order_Cancellation_and_Validity" name="Order Cancellation and Validity" namespace="urn:bridge:jbilling:Definitions_Order_Cancellation_and_Validity"><decision id="Decision_CancellationFeeEligibility" name="Cancellation Fee Eligibility"><decisionTable id="Decision_CancellationFeeEligibility_Table" hitPolicy="FIRST"><input id="Decision_CancellationFeeEligibility_Input_1" label="Event Type"><inputExpression id="Decision_CancellationFeeEligibility_InputExpr_1" typeRef="string"><text>eventType</text></inputExpression><inputValues id="Decision_CancellationFeeEligibility_InputVals_1"><text>"NEW_ACTIVE_UNTIL","NEW_QUANTITY"</text></inputValues></input><input id="Decision_CancellationFeeEligibility_Input_2" label="New Active-Until Provided"><inputExpression id="Decision_CancellationFeeEligibility_InputExpr_2" typeRef="boolean"><text>newActiveUntilProvided</text></inputExpression></input><input id="Decision_CancellationFeeEligibility_Input_3" label="Old Active-Until Provided"><inputExpression id="Decision_CancellationFeeEligibility_InputExpr_3" typeRef="boolean"><text>oldActiveUntilProvided</text></inputExpression></input><input id="Decision_CancellationFeeEligibility_Input_4" label="New Active-Until"><inputExpression id="Decision_CancellationFeeEligibility_InputExpr_4" typeRef="date"><text>newActiveUntil</text></inputExpression></input><input id="Decision_CancellationFeeEligibility_Input_5" label="Old Active-Until"><inputExpression id="Decision_CancellationFeeEligibility_InputExpr_5" typeRef="date"><text>oldActiveUntil</text></inputExpression></input><input id="Decision_CancellationFeeEligibility_Input_6" label="New Quantity"><inputExpression id="Decision_CancellationFeeEligibility_InputExpr_6" typeRef="number"><text>newQuantity</text></inputExpression></input><input id="Decision_CancellationFeeEligibility_Input_7" label="Old Quantity"><inputExpression id="Decision_CancellationFeeEligibility_InputExpr_7" typeRef="number"><text>oldQuantity</text></inputExpression></input><output id="Decision_CancellationFeeEligibility_Output_1" label="Process Cancellation Fee" name="processCancellationFee" typeRef="boolean" /><rule id="Decision_CancellationFeeEligibility_Rule_1"><description>CancellationFeeRulesTask.java L76-83: newActiveUntil == null -&gt; nothing to evaluate, skip</description><inputEntry id="Decision_CancellationFeeEligibility_Rule_1_InEntry_1"><text>"NEW_ACTIVE_UNTIL"</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_1_InEntry_2"><text>false</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_1_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_1_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_1_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_1_InEntry_6"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_1_InEntry_7"><text>-</text></inputEntry><outputEntry id="Decision_CancellationFeeEligibility_Rule_1_OutEntry_1"><text>false</text></outputEntry></rule><rule id="Decision_CancellationFeeEligibility_Rule_2"><description>L76-83: old date exists and the new one is not earlier, so nothing was actually cancelled, skip -- modeled as a cross-variable date comparison (oldActiveUntil &lt;= newActiveUntil)</description><inputEntry id="Decision_CancellationFeeEligibility_Rule_2_InEntry_1"><text>"NEW_ACTIVE_UNTIL"</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_2_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_2_InEntry_3"><text>true</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_2_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_2_InEntry_5"><text>&lt;= newActiveUntil</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_2_InEntry_6"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_2_InEntry_7"><text>-</text></inputEntry><outputEntry id="Decision_CancellationFeeEligibility_Rule_2_OutEntry_1"><text>false</text></outputEntry></rule><rule id="Decision_CancellationFeeEligibility_Rule_3"><description>L85-128 (implicit else): old date exists and new date is genuinely earlier -- a real period was cut short, proceed</description><inputEntry id="Decision_CancellationFeeEligibility_Rule_3_InEntry_1"><text>"NEW_ACTIVE_UNTIL"</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_3_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_3_InEntry_3"><text>true</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_3_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_3_InEntry_5"><text>&gt; newActiveUntil</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_3_InEntry_6"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_3_InEntry_7"><text>-</text></inputEntry><outputEntry id="Decision_CancellationFeeEligibility_Rule_3_OutEntry_1"><text>true</text></outputEntry></rule><rule id="Decision_CancellationFeeEligibility_Rule_4"><description>L85-128 (implicit else): no old active-until to compare against, so the L76-83 guard never trips -- proceed</description><inputEntry id="Decision_CancellationFeeEligibility_Rule_4_InEntry_1"><text>"NEW_ACTIVE_UNTIL"</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_4_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_4_InEntry_3"><text>false</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_4_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_4_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_4_InEntry_6"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_4_InEntry_7"><text>-</text></inputEntry><outputEntry id="Decision_CancellationFeeEligibility_Rule_4_OutEntry_1"><text>true</text></outputEntry></rule><rule id="Decision_CancellationFeeEligibility_Rule_5"><description>L90-92: newQuantity &gt; oldQuantity -- quantity went up, not a cancellation, skip -- modeled as a cross-variable comparison</description><inputEntry id="Decision_CancellationFeeEligibility_Rule_5_InEntry_1"><text>"NEW_QUANTITY"</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_5_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_5_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_5_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_5_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_5_InEntry_6"><text>&gt; oldQuantity</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_5_InEntry_7"><text>-</text></inputEntry><outputEntry id="Decision_CancellationFeeEligibility_Rule_5_OutEntry_1"><text>false</text></outputEntry></rule><rule id="Decision_CancellationFeeEligibility_Rule_6"><description>L94-109 (implicit else): quantity decreased or stayed the same -- build a copy of the order with the cancelled quantity and proceed</description><inputEntry id="Decision_CancellationFeeEligibility_Rule_6_InEntry_1"><text>"NEW_QUANTITY"</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_6_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_6_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_6_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_6_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_6_InEntry_6"><text>&lt;= oldQuantity</text></inputEntry><inputEntry id="Decision_CancellationFeeEligibility_Rule_6_InEntry_7"><text>-</text></inputEntry><outputEntry id="Decision_CancellationFeeEligibility_Rule_6_OutEntry_1"><text>true</text></outputEntry></rule></decisionTable></decision><decision id="Decision_OrderPeriodAlreadyInvoiced" name="Order Period Already Invoiced"><decisionTable id="Decision_OrderPeriodAlreadyInvoiced_Table" hitPolicy="FIRST"><input id="Decision_OrderPeriodAlreadyInvoiced_Input_1" label="Candidate Date Provided"><inputExpression id="Decision_OrderPeriodAlreadyInvoiced_InputExpr_1" typeRef="boolean"><text>candidateDateProvided</text></inputExpression></input><input id="Decision_OrderPeriodAlreadyInvoiced_Input_2" label="Next Billable Day Provided"><inputExpression id="Decision_OrderPeriodAlreadyInvoiced_InputExpr_2" typeRef="boolean"><text>nextBillableDayProvided</text></inputExpression></input><input id="Decision_OrderPeriodAlreadyInvoiced_Input_3" label="Candidate Date"><inputExpression id="Decision_OrderPeriodAlreadyInvoiced_InputExpr_3" typeRef="date"><text>candidateDate</text></inputExpression></input><input id="Decision_OrderPeriodAlreadyInvoiced_Input_4" label="Next Billable Day"><inputExpression id="Decision_OrderPeriodAlreadyInvoiced_InputExpr_4" typeRef="date"><text>nextBillableDay</text></inputExpression></input><output id="Decision_OrderPeriodAlreadyInvoiced_Output_1" label="Period Already Invoiced" name="periodAlreadyInvoiced" typeRef="boolean" /><rule id="Decision_OrderPeriodAlreadyInvoiced_Rule_1"><description>OrderBL.java L1106-1107: a null candidate date can never be "already invoiced"</description><inputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_1_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_1_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_1_InEntry_4"><text>-</text></inputEntry><outputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_1_OutEntry_1"><text>false</text></outputEntry></rule><rule id="Decision_OrderPeriodAlreadyInvoiced_Rule_2"><description>L1106-1107: no next-billable-day set -&gt; nothing to compare against, false</description><inputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_2_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_2_InEntry_2"><text>false</text></inputEntry><inputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_2_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_2_InEntry_4"><text>-</text></inputEntry><outputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_2_OutEntry_1"><text>false</text></outputEntry></rule><rule id="Decision_OrderPeriodAlreadyInvoiced_Rule_3"><description>L1107: candidate date is not before the next billable day -- modeled as a cross-variable date comparison</description><inputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_3_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_3_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_3_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_3_InEntry_4"><text>&gt;= nextBillableDay</text></inputEntry><outputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_3_OutEntry_1"><text>false</text></outputEntry></rule><rule id="Decision_OrderPeriodAlreadyInvoiced_Rule_4"><description>L1105-1108: candidate date falls before the order's next billable day -- a period that was already going to be invoiced is being shortened</description><inputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_4_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_4_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_4_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_4_InEntry_4"><text>&lt; nextBillableDay</text></inputEntry><outputEntry id="Decision_OrderPeriodAlreadyInvoiced_Rule_4_OutEntry_1"><text>true</text></outputEntry></rule></decisionTable></decision><decision id="Decision_OrderDateRangeValid" name="Order Date Range Valid"><decisionTable id="Decision_OrderDateRangeValid_Table" hitPolicy="FIRST"><input id="Decision_OrderDateRangeValid_Input_1" label="Reflection/Parse Error Occurred"><inputExpression id="Decision_OrderDateRangeValid_InputExpr_1" typeRef="boolean"><text>parseOrAccessError</text></inputExpression></input><input id="Decision_OrderDateRangeValid_Input_2" label="Start Date Provided"><inputExpression id="Decision_OrderDateRangeValid_InputExpr_2" typeRef="boolean"><text>startDateProvided</text></inputExpression></input><input id="Decision_OrderDateRangeValid_Input_3" label="End Date Provided"><inputExpression id="Decision_OrderDateRangeValid_InputExpr_3" typeRef="boolean"><text>endDateProvided</text></inputExpression></input><input id="Decision_OrderDateRangeValid_Input_4" label="Start Date"><inputExpression id="Decision_OrderDateRangeValid_InputExpr_4" typeRef="date"><text>startDate</text></inputExpression></input><input id="Decision_OrderDateRangeValid_Input_5" label="End Date"><inputExpression id="Decision_OrderDateRangeValid_InputExpr_5" typeRef="date"><text>endDate</text></inputExpression></input><output id="Decision_OrderDateRangeValid_Output_1" label="Date Range Valid" name="dateRangeValid" typeRef="boolean" /><rule id="Decision_OrderDateRangeValid_Rule_1"><description>DateRangeValidator.java L74-84: any reflection or date-parsing failure is treated as invalid</description><inputEntry id="Decision_OrderDateRangeValid_Rule_1_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_1_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_1_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_1_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_OrderDateRangeValid_Rule_1_OutEntry_1"><text>false</text></outputEntry></rule><rule id="Decision_OrderDateRangeValid_Rule_2"><description>L63-64: a missing start date is vacuously valid</description><inputEntry id="Decision_OrderDateRangeValid_Rule_2_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_2_InEntry_2"><text>false</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_2_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_2_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_2_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_OrderDateRangeValid_Rule_2_OutEntry_1"><text>true</text></outputEntry></rule><rule id="Decision_OrderDateRangeValid_Rule_3"><description>L66-67: a missing end date is likewise vacuously valid</description><inputEntry id="Decision_OrderDateRangeValid_Rule_3_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_3_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_3_InEntry_3"><text>false</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_3_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_3_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_OrderDateRangeValid_Rule_3_OutEntry_1"><text>true</text></outputEntry></rule><rule id="Decision_OrderDateRangeValid_Rule_4"><description>L69-72: both dates present and start genuinely precedes end -- modeled as a cross-variable date comparison</description><inputEntry id="Decision_OrderDateRangeValid_Rule_4_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_4_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_4_InEntry_3"><text>true</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_4_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_4_InEntry_5"><text>&gt; startDate</text></inputEntry><outputEntry id="Decision_OrderDateRangeValid_Rule_4_OutEntry_1"><text>true</text></outputEntry></rule><rule id="Decision_OrderDateRangeValid_Rule_5"><description>L69-72: both dates present but start is on/after end -- invalid</description><inputEntry id="Decision_OrderDateRangeValid_Rule_5_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_5_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_5_InEntry_3"><text>true</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_5_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateRangeValid_Rule_5_InEntry_5"><text>&lt;= startDate</text></inputEntry><outputEntry id="Decision_OrderDateRangeValid_Rule_5_OutEntry_1"><text>false</text></outputEntry></rule></decisionTable></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_Order_Cancellation_and_Validity_Diagram"><dmndi:DMNShape id="Decision_CancellationFeeEligibility_Shape" dmnElementRef="Decision_CancellationFeeEligibility"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_OrderPeriodAlreadyInvoiced_Shape" dmnElementRef="Decision_OrderPeriodAlreadyInvoiced"><dc:Bounds x="60" y="260" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_OrderDateRangeValid_Shape" dmnElementRef="Decision_OrderDateRangeValid"><dc:Bounds x="60" y="460" width="220" height="90" /></dmndi:DMNShape></dmndi:DMNDiagram></dmndi:DMNDI></definitions>