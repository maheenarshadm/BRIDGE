<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_Concept_Name_Uniqueness_And_Presence" name="Concept Name Uniqueness And Presence" namespace="urn:bridge:openmrs:Definitions_Concept_Name_Uniqueness_And_Presence"><decision id="Decision_ConceptLocalePreferredNameUniqueness" name="Concept Locale-Preferred-Name Uniqueness"><decisionTable id="Decision_ConceptLocalePreferredNameUniqueness_Table" hitPolicy="FIRST"><input id="Decision_ConceptLocalePreferredNameUniqueness_Input_1" label="Locale Preferred Name Count"><inputExpression id="Decision_ConceptLocalePreferredNameUniqueness_InputExpr_1" typeRef="number"><text>localePreferredNameCount</text></inputExpression></input><output id="Decision_ConceptLocalePreferredNameUniqueness_Output_1" label="Locale Preferred Name Valid" name="localePreferredNameValid" typeRef="boolean" /><output id="Decision_ConceptLocalePreferredNameUniqueness_Output_2" label="Reason Code" name="reasonCode" typeRef="string" /><rule id="Decision_ConceptLocalePreferredNameUniqueness_Rule_1"><description>ConceptValidator.java L154-158 -- "should have one preferred name per locale"; a SECOND unretired, unvoided name in the same (concept, locale) marked locale_preferred=true rejects Concept.error.multipleLocalePreferredNames. Modeled as COUNT(...) &gt;= 2.</description><inputEntry id="Decision_ConceptLocalePreferredNameUniqueness_Rule_1_InEntry_1"><text>&gt;= 2</text></inputEntry><outputEntry id="Decision_ConceptLocalePreferredNameUniqueness_Rule_1_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_ConceptLocalePreferredNameUniqueness_Rule_1_OutEntry_2"><text>"Concept.error.multipleLocalePreferredNames"</text></outputEntry></rule><rule id="Decision_ConceptLocalePreferredNameUniqueness_Rule_2"><description>at most one locale-preferred name in this (concept, locale) -- no violation</description><inputEntry id="Decision_ConceptLocalePreferredNameUniqueness_Rule_2_InEntry_1"><text>&lt;= 1</text></inputEntry><outputEntry id="Decision_ConceptLocalePreferredNameUniqueness_Rule_2_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_ConceptLocalePreferredNameUniqueness_Rule_2_OutEntry_2"><text>"none"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_ConceptFullySpecifiedNameUniquenessPerLocale" name="Concept Fully-Specified-Name Uniqueness Per Locale"><decisionTable id="Decision_ConceptFullySpecifiedNameUniquenessPerLocale_Table" hitPolicy="FIRST"><input id="Decision_ConceptFullySpecifiedNameUniquenessPerLocale_Input_1" label="Fully Specified Name Count In Locale"><inputExpression id="Decision_ConceptFullySpecifiedNameUniquenessPerLocale_InputExpr_1" typeRef="number"><text>fullySpecifiedNameCountInLocale</text></inputExpression></input><output id="Decision_ConceptFullySpecifiedNameUniquenessPerLocale_Output_1" label="Fully Specified Name Valid" name="fullySpecifiedNameValid" typeRef="boolean" /><output id="Decision_ConceptFullySpecifiedNameUniquenessPerLocale_Output_2" label="Reason Code" name="reasonCode" typeRef="string" /><rule id="Decision_ConceptFullySpecifiedNameUniquenessPerLocale_Rule_1"><description>ConceptValidator.java L161-170 -- "should not allow multiple fully specified conceptNames in a given locale"; a SECOND unretired, unvoided name in the same (concept, locale) with concept_name_type=FULLY_SPECIFIED rejects Concept.error.multipleFullySpecifiedNames.</description><inputEntry id="Decision_ConceptFullySpecifiedNameUniquenessPerLocale_Rule_1_InEntry_1"><text>&gt;= 2</text></inputEntry><outputEntry id="Decision_ConceptFullySpecifiedNameUniquenessPerLocale_Rule_1_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_ConceptFullySpecifiedNameUniquenessPerLocale_Rule_1_OutEntry_2"><text>"Concept.error.multipleFullySpecifiedNames"</text></outputEntry></rule><rule id="Decision_ConceptFullySpecifiedNameUniquenessPerLocale_Rule_2"><description>at most one fully-specified name in this (concept, locale) -- no violation</description><inputEntry id="Decision_ConceptFullySpecifiedNameUniquenessPerLocale_Rule_2_InEntry_1"><text>&lt;= 1</text></inputEntry><outputEntry id="Decision_ConceptFullySpecifiedNameUniquenessPerLocale_Rule_2_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_ConceptFullySpecifiedNameUniquenessPerLocale_Rule_2_OutEntry_2"><text>"none"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_ConceptShortNameUniquenessPerLocale" name="Concept Short-Name Uniqueness Per Locale"><decisionTable id="Decision_ConceptShortNameUniquenessPerLocale_Table" hitPolicy="FIRST"><input id="Decision_ConceptShortNameUniquenessPerLocale_Input_1" label="Short Name Count In Locale"><inputExpression id="Decision_ConceptShortNameUniquenessPerLocale_InputExpr_1" typeRef="number"><text>shortNameCountInLocale</text></inputExpression></input><output id="Decision_ConceptShortNameUniquenessPerLocale_Output_1" label="Short Name Valid" name="shortNameValid" typeRef="boolean" /><output id="Decision_ConceptShortNameUniquenessPerLocale_Output_2" label="Reason Code" name="reasonCode" typeRef="string" /><rule id="Decision_ConceptShortNameUniquenessPerLocale_Rule_1"><description>ConceptValidator.java L178-186 -- "should not allow multiple short names in a given locale"; a SECOND unretired, unvoided name in the same (concept, locale) with concept_name_type=SHORT rejects Concept.error.multipleShortNames.</description><inputEntry id="Decision_ConceptShortNameUniquenessPerLocale_Rule_1_InEntry_1"><text>&gt;= 2</text></inputEntry><outputEntry id="Decision_ConceptShortNameUniquenessPerLocale_Rule_1_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_ConceptShortNameUniquenessPerLocale_Rule_1_OutEntry_2"><text>"Concept.error.multipleShortNames"</text></outputEntry></rule><rule id="Decision_ConceptShortNameUniquenessPerLocale_Rule_2"><description>at most one short name in this (concept, locale) -- no violation</description><inputEntry id="Decision_ConceptShortNameUniquenessPerLocale_Rule_2_InEntry_1"><text>&lt;= 1</text></inputEntry><outputEntry id="Decision_ConceptShortNameUniquenessPerLocale_Rule_2_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_ConceptShortNameUniquenessPerLocale_Rule_2_OutEntry_2"><text>"none"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_ConceptFullySpecifiedNamePresenceRequirement" name="Concept Fully-Specified-Name Presence Requirement"><decisionTable id="Decision_ConceptFullySpecifiedNamePresenceRequirement_Table" hitPolicy="FIRST"><input id="Decision_ConceptFullySpecifiedNamePresenceRequirement_Input_1" label="Fully Specified Name Count"><inputExpression id="Decision_ConceptFullySpecifiedNamePresenceRequirement_InputExpr_1" typeRef="number"><text>fullySpecifiedNameCount</text></inputExpression></input><output id="Decision_ConceptFullySpecifiedNamePresenceRequirement_Output_1" label="Fully Specified Name Present" name="fullySpecifiedNamePresent" typeRef="boolean" /><output id="Decision_ConceptFullySpecifiedNamePresenceRequirement_Output_2" label="Reason Code" name="reasonCode" typeRef="string" /><rule id="Decision_ConceptFullySpecifiedNamePresenceRequirement_Rule_1"><description>ConceptValidator.java L217-220 -- "should fail if there is no name explicitly marked as fully specified"; hasFullySpecifiedName is set true the moment ANY locale contributes one, so this is a COUNT across every locale for the concept, not scoped to one -- zero anywhere rejects Concept.error.no.FullySpecifiedName. Exposed as COUNT(...) &gt;= 1, the same "at least one" shape as Preferred Identifier Requirement's own Rule_1.</description><inputEntry id="Decision_ConceptFullySpecifiedNamePresenceRequirement_Rule_1_InEntry_1"><text>&gt;= 1</text></inputEntry><outputEntry id="Decision_ConceptFullySpecifiedNamePresenceRequirement_Rule_1_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_ConceptFullySpecifiedNamePresenceRequirement_Rule_1_OutEntry_2"><text>"none"</text></outputEntry></rule><rule id="Decision_ConceptFullySpecifiedNamePresenceRequirement_Rule_2"><description>L217-220 -- zero fully specified names anywhere for this concept</description><inputEntry id="Decision_ConceptFullySpecifiedNamePresenceRequirement_Rule_2_InEntry_1"><text>0</text></inputEntry><outputEntry id="Decision_ConceptFullySpecifiedNamePresenceRequirement_Rule_2_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_ConceptFullySpecifiedNamePresenceRequirement_Rule_2_OutEntry_2"><text>"Concept.error.no.FullySpecifiedName"</text></outputEntry></rule></decisionTable></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_Concept_Name_Uniqueness_And_Presence_Diagram"><dmndi:DMNShape id="Decision_ConceptLocalePreferredNameUniqueness_Shape" dmnElementRef="Decision_ConceptLocalePreferredNameUniqueness"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_ConceptFullySpecifiedNameUniquenessPerLocale_Shape" dmnElementRef="Decision_ConceptFullySpecifiedNameUniquenessPerLocale"><dc:Bounds x="60" y="260" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_ConceptShortNameUniquenessPerLocale_Shape" dmnElementRef="Decision_ConceptShortNameUniquenessPerLocale"><dc:Bounds x="60" y="460" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_ConceptFullySpecifiedNamePresenceRequirement_Shape" dmnElementRef="Decision_ConceptFullySpecifiedNamePresenceRequirement"><dc:Bounds x="60" y="660" width="220" height="90" /></dmndi:DMNShape></dmndi:DMNDiagram></dmndi:DMNDI></definitions>
