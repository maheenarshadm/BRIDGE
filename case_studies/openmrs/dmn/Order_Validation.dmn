<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_Order_Validation" name="Order Validation" namespace="urn:bridge:openmrs:Definitions_Order_Validation"><decision id="Decision_OrderDateActivatedConsistencyViolations" name="Order Date Activated Consistency Violations"><decisionTable id="Decision_OrderDateActivatedConsistencyViolations_Table" hitPolicy="COLLECT"><input id="Decision_OrderDateActivatedConsistencyViolations_Input_1" label="Date Activated Set"><inputExpression id="Decision_OrderDateActivatedConsistencyViolations_InputExpr_1" typeRef="boolean"><text>dateActivatedSet</text></inputExpression></input><input id="Decision_OrderDateActivatedConsistencyViolations_Input_2" label="Date Activated"><inputExpression id="Decision_OrderDateActivatedConsistencyViolations_InputExpr_2" typeRef="date"><text>dateActivated</text></inputExpression></input><input id="Decision_OrderDateActivatedConsistencyViolations_Input_3" label="Evaluation Time"><inputExpression id="Decision_OrderDateActivatedConsistencyViolations_InputExpr_3" typeRef="date"><text>evaluationTime</text></inputExpression></input><input id="Decision_OrderDateActivatedConsistencyViolations_Input_4" label="Date Stopped Set"><inputExpression id="Decision_OrderDateActivatedConsistencyViolations_InputExpr_4" typeRef="boolean"><text>dateStoppedSet</text></inputExpression></input><input id="Decision_OrderDateActivatedConsistencyViolations_Input_5" label="Date Stopped"><inputExpression id="Decision_OrderDateActivatedConsistencyViolations_InputExpr_5" typeRef="date"><text>dateStopped</text></inputExpression></input><input id="Decision_OrderDateActivatedConsistencyViolations_Input_6" label="Auto Expire Date Set"><inputExpression id="Decision_OrderDateActivatedConsistencyViolations_InputExpr_6" typeRef="boolean"><text>autoExpireDateSet</text></inputExpression></input><input id="Decision_OrderDateActivatedConsistencyViolations_Input_7" label="Auto Expire Date"><inputExpression id="Decision_OrderDateActivatedConsistencyViolations_InputExpr_7" typeRef="date"><text>autoExpireDate</text></inputExpression></input><input id="Decision_OrderDateActivatedConsistencyViolations_Input_8" label="Encounter Datetime Set"><inputExpression id="Decision_OrderDateActivatedConsistencyViolations_InputExpr_8" typeRef="boolean"><text>encounterDatetimeSet</text></inputExpression></input><input id="Decision_OrderDateActivatedConsistencyViolations_Input_9" label="Encounter Datetime"><inputExpression id="Decision_OrderDateActivatedConsistencyViolations_InputExpr_9" typeRef="date"><text>encounterDatetime</text></inputExpression></input><output id="Decision_OrderDateActivatedConsistencyViolations_Output_1" label="Violation Reason" name="violationReasons" typeRef="string" /><rule id="Decision_OrderDateActivatedConsistencyViolations_Rule_1"><description>L112-115 -- modeled as a date comparison against an explicit evaluationTime; verified: this check DOES return early in the real source, so it is mutually exclusive with the three checks below by construction</description><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_1_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_1_InEntry_2"><text>&gt; evaluationTime</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_1_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_1_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_1_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_1_InEntry_6"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_1_InEntry_7"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_1_InEntry_8"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_1_InEntry_9"><text>-</text></inputEntry><outputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_1_OutEntry_1"><text>"Order.error.dateActivatedInFuture"</text></outputEntry></rule><rule id="Decision_OrderDateActivatedConsistencyViolations_Rule_2"><description>L116-120 -- modeled as a cross-variable date comparison (dateActivated &gt; dateStopped); verified: no return after this check, independent of the two below</description><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_2_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_2_InEntry_2"><text>&gt; dateStopped</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_2_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_2_InEntry_4"><text>true</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_2_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_2_InEntry_6"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_2_InEntry_7"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_2_InEntry_8"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_2_InEntry_9"><text>-</text></inputEntry><outputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_2_OutEntry_1"><text>"Order.error.dateActivatedAfterDiscontinuedDate"</text></outputEntry></rule><rule id="Decision_OrderDateActivatedConsistencyViolations_Rule_3"><description>L121-125 -- modeled as a cross-variable date comparison (dateActivated &gt; autoExpireDate); verified: can co-fire with the discontinued-date and encounter checks</description><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_3_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_3_InEntry_2"><text>&gt; autoExpireDate</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_3_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_3_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_3_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_3_InEntry_6"><text>true</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_3_InEntry_7"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_3_InEntry_8"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_3_InEntry_9"><text>-</text></inputEntry><outputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_3_OutEntry_1"><text>"Order.error.dateActivatedAfterAutoExpireDate"</text></outputEntry></rule><rule id="Decision_OrderDateActivatedConsistencyViolations_Rule_4"><description>L126-130 -- modeled as a cross-variable date comparison (encounterDatetime &gt; dateActivated); verified: no return before this, the last check in the method; can co-fire with either check above</description><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_4_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_4_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_4_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_4_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_4_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_4_InEntry_6"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_4_InEntry_7"><text>-</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_4_InEntry_8"><text>true</text></inputEntry><inputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_4_InEntry_9"><text>&gt; dateActivated</text></inputEntry><outputEntry id="Decision_OrderDateActivatedConsistencyViolations_Rule_4_OutEntry_1"><text>"Order.error.encounterDatetimeAfterDateActivated"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_OrderDateActivatedConsistency" name="Order Date Activated Consistency"><variable id="Decision_OrderDateActivatedConsistency_Var" name="dateActivatedValid" typeRef="boolean" /><informationRequirement id="InfoReq_1"><requiredDecision href="#Decision_OrderDateActivatedConsistencyViolations" /></informationRequirement><literalExpression id="Decision_OrderDateActivatedConsistency_Expr"><text>count(violationReasons) = 0</text></literalExpression></decision><decision id="Decision_OrderScheduledDateUrgencyConsistency" name="Order Scheduled Date Urgency Consistency"><decisionTable id="Decision_OrderScheduledDateUrgencyConsistency_Table" hitPolicy="UNIQUE"><input id="Decision_OrderScheduledDateUrgencyConsistency_Input_1" label="Scheduled Date Set"><inputExpression id="Decision_OrderScheduledDateUrgencyConsistency_InputExpr_1" typeRef="boolean"><text>scheduledDateSet</text></inputExpression></input><input id="Decision_OrderScheduledDateUrgencyConsistency_Input_2" label="Urgency"><inputExpression id="Decision_OrderScheduledDateUrgencyConsistency_InputExpr_2" typeRef="string"><text>urgency</text></inputExpression><inputValues id="Decision_OrderScheduledDateUrgencyConsistency_InputVals_2"><text>"ON_SCHEDULED_DATE","ROUTINE","STAT"</text></inputValues></input><output id="Decision_OrderScheduledDateUrgencyConsistency_Output_1" label="Scheduled Date Urgency Valid" name="scheduledDateUrgencyValid" typeRef="boolean" /><output id="Decision_OrderScheduledDateUrgencyConsistency_Output_2" label="Reason Code" name="reasonCode" typeRef="string" /><rule id="Decision_OrderScheduledDateUrgencyConsistency_Rule_1"><description>L141-149 -- modeled as a categorical test against the actual urgency column</description><inputEntry id="Decision_OrderScheduledDateUrgencyConsistency_Rule_1_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_OrderScheduledDateUrgencyConsistency_Rule_1_InEntry_2"><text>"ON_SCHEDULED_DATE"</text></inputEntry><outputEntry id="Decision_OrderScheduledDateUrgencyConsistency_Rule_1_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_OrderScheduledDateUrgencyConsistency_Rule_1_OutEntry_2"><text>"none"</text></outputEntry></rule><rule id="Decision_OrderScheduledDateUrgencyConsistency_Rule_2"><description>L144-146</description><inputEntry id="Decision_OrderScheduledDateUrgencyConsistency_Rule_2_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_OrderScheduledDateUrgencyConsistency_Rule_2_InEntry_2"><text>!= "ON_SCHEDULED_DATE"</text></inputEntry><outputEntry id="Decision_OrderScheduledDateUrgencyConsistency_Rule_2_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_OrderScheduledDateUrgencyConsistency_Rule_2_OutEntry_2"><text>"Order.error.urgencyNotOnScheduledDate"</text></outputEntry></rule><rule id="Decision_OrderScheduledDateUrgencyConsistency_Rule_3"><description>L147-149</description><inputEntry id="Decision_OrderScheduledDateUrgencyConsistency_Rule_3_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_OrderScheduledDateUrgencyConsistency_Rule_3_InEntry_2"><text>"ON_SCHEDULED_DATE"</text></inputEntry><outputEntry id="Decision_OrderScheduledDateUrgencyConsistency_Rule_3_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_OrderScheduledDateUrgencyConsistency_Rule_3_OutEntry_2"><text>"Order.error.scheduledDateNullForOnScheduledDateUrgency"</text></outputEntry></rule><rule id="Decision_OrderScheduledDateUrgencyConsistency_Rule_4"><description>L141-149 both conditions false</description><inputEntry id="Decision_OrderScheduledDateUrgencyConsistency_Rule_4_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_OrderScheduledDateUrgencyConsistency_Rule_4_InEntry_2"><text>!= "ON_SCHEDULED_DATE"</text></inputEntry><outputEntry id="Decision_OrderScheduledDateUrgencyConsistency_Rule_4_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_OrderScheduledDateUrgencyConsistency_Rule_4_OutEntry_2"><text>"none"</text></outputEntry></rule></decisionTable></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_Order_Validation_Diagram"><dmndi:DMNShape id="Decision_OrderDateActivatedConsistencyViolations_Shape" dmnElementRef="Decision_OrderDateActivatedConsistencyViolations"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_OrderDateActivatedConsistency_Shape" dmnElementRef="Decision_OrderDateActivatedConsistency"><dc:Bounds x="370" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_OrderScheduledDateUrgencyConsistency_Shape" dmnElementRef="Decision_OrderScheduledDateUrgencyConsistency"><dc:Bounds x="60" y="260" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNEdge id="Edge_1" dmnElementRef="InfoReq_1"><di:waypoint x="280" y="105" /><di:waypoint x="370" y="105" /></dmndi:DMNEdge></dmndi:DMNDiagram></dmndi:DMNDI></definitions>