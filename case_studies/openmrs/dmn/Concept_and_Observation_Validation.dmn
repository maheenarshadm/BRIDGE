<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_Concept_and_Observation_Validation" name="Concept and Observation Validation" namespace="urn:bridge:openmrs:Definitions_Concept_and_Observation_Validation"><decision id="Decision_ObsValueRequiredByDatatype" name="Obs Value Required By Datatype"><decisionTable id="Decision_ObsValueRequiredByDatatype_Table" hitPolicy="UNIQUE"><input id="Decision_ObsValueRequiredByDatatype_Input_1" label="Is Obs Group"><inputExpression id="Decision_ObsValueRequiredByDatatype_InputExpr_1" typeRef="boolean"><text>isObsGroup</text></inputExpression></input><input id="Decision_ObsValueRequiredByDatatype_Input_2" label="Concept Datatype"><inputExpression id="Decision_ObsValueRequiredByDatatype_InputExpr_2" typeRef="string"><text>conceptDatatype</text></inputExpression><inputValues id="Decision_ObsValueRequiredByDatatype_InputVals_2"><text>"Boolean","Coded","Datetime","Date","Time","Numeric","Text"</text></inputValues></input><output id="Decision_ObsValueRequiredByDatatype_Output_1" label="Required Value Column" name="requiredValueColumn" typeRef="string" /><rule id="Decision_ObsValueRequiredByDatatype_Rule_1"><description>L117-150</description><inputEntry id="Decision_ObsValueRequiredByDatatype_Rule_1_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_ObsValueRequiredByDatatype_Rule_1_InEntry_2"><text>-</text></inputEntry><outputEntry id="Decision_ObsValueRequiredByDatatype_Rule_1_OutEntry_1"><text>"none (obs group must carry no value column)"</text></outputEntry></rule><rule id="Decision_ObsValueRequiredByDatatype_Rule_2"><description>L168-173</description><inputEntry id="Decision_ObsValueRequiredByDatatype_Rule_2_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_ObsValueRequiredByDatatype_Rule_2_InEntry_2"><text>"Boolean"</text></inputEntry><outputEntry id="Decision_ObsValueRequiredByDatatype_Rule_2_OutEntry_1"><text>"value_coded (via true/false concept -- no value_boolean column exists)"</text></outputEntry></rule><rule id="Decision_ObsValueRequiredByDatatype_Rule_3"><description>L174-179</description><inputEntry id="Decision_ObsValueRequiredByDatatype_Rule_3_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_ObsValueRequiredByDatatype_Rule_3_InEntry_2"><text>"Coded"</text></inputEntry><outputEntry id="Decision_ObsValueRequiredByDatatype_Rule_3_OutEntry_1"><text>"value_coded"</text></outputEntry></rule><rule id="Decision_ObsValueRequiredByDatatype_Rule_4"><description>L180-185</description><inputEntry id="Decision_ObsValueRequiredByDatatype_Rule_4_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_ObsValueRequiredByDatatype_Rule_4_InEntry_2"><text>"Datetime","Date","Time"</text></inputEntry><outputEntry id="Decision_ObsValueRequiredByDatatype_Rule_4_OutEntry_1"><text>"value_datetime"</text></outputEntry></rule><rule id="Decision_ObsValueRequiredByDatatype_Rule_5"><description>L186-191</description><inputEntry id="Decision_ObsValueRequiredByDatatype_Rule_5_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_ObsValueRequiredByDatatype_Rule_5_InEntry_2"><text>"Numeric"</text></inputEntry><outputEntry id="Decision_ObsValueRequiredByDatatype_Rule_5_OutEntry_1"><text>"value_numeric"</text></outputEntry></rule><rule id="Decision_ObsValueRequiredByDatatype_Rule_6"><description>L204-210</description><inputEntry id="Decision_ObsValueRequiredByDatatype_Rule_6_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_ObsValueRequiredByDatatype_Rule_6_InEntry_2"><text>"Text"</text></inputEntry><outputEntry id="Decision_ObsValueRequiredByDatatype_Rule_6_OutEntry_1"><text>"value_text"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_ObsGroupValueExclusivity" name="Obs Group Value Exclusivity"><decisionTable id="Decision_ObsGroupValueExclusivity_Table" hitPolicy="UNIQUE"><input id="Decision_ObsGroupValueExclusivity_Input_1" label="Is Obs Group"><inputExpression id="Decision_ObsGroupValueExclusivity_InputExpr_1" typeRef="boolean"><text>isObsGroup</text></inputExpression></input><input id="Decision_ObsGroupValueExclusivity_Input_2" label="Any Value Field Set"><inputExpression id="Decision_ObsGroupValueExclusivity_InputExpr_2" typeRef="boolean"><text>anyValueFieldSet</text></inputExpression></input><output id="Decision_ObsGroupValueExclusivity_Output_1" label="Obs Structure Valid" name="obsStructureValid" typeRef="boolean" /><output id="Decision_ObsGroupValueExclusivity_Output_2" label="Reason Code" name="reasonCode" typeRef="string" /><rule id="Decision_ObsGroupValueExclusivity_Rule_1"><description>L117-150</description><inputEntry id="Decision_ObsGroupValueExclusivity_Rule_1_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_ObsGroupValueExclusivity_Rule_1_InEntry_2"><text>true</text></inputEntry><outputEntry id="Decision_ObsGroupValueExclusivity_Rule_1_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_ObsGroupValueExclusivity_Rule_1_OutEntry_2"><text>"error.not.null (group carries a value field)"</text></outputEntry></rule><rule id="Decision_ObsGroupValueExclusivity_Rule_2"><description>L117-150 all value-field checks pass</description><inputEntry id="Decision_ObsGroupValueExclusivity_Rule_2_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_ObsGroupValueExclusivity_Rule_2_InEntry_2"><text>false</text></inputEntry><outputEntry id="Decision_ObsGroupValueExclusivity_Rule_2_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_ObsGroupValueExclusivity_Rule_2_OutEntry_2"><text>"validGroup"</text></outputEntry></rule><rule id="Decision_ObsGroupValueExclusivity_Rule_3"><description>L151-157</description><inputEntry id="Decision_ObsGroupValueExclusivity_Rule_3_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_ObsGroupValueExclusivity_Rule_3_InEntry_2"><text>false</text></inputEntry><outputEntry id="Decision_ObsGroupValueExclusivity_Rule_3_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_ObsGroupValueExclusivity_Rule_3_OutEntry_2"><text>"error.noValue"</text></outputEntry></rule><rule id="Decision_ObsGroupValueExclusivity_Rule_4"><description>at least one value present</description><inputEntry id="Decision_ObsGroupValueExclusivity_Rule_4_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_ObsGroupValueExclusivity_Rule_4_InEntry_2"><text>true</text></inputEntry><outputEntry id="Decision_ObsGroupValueExclusivity_Rule_4_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_ObsGroupValueExclusivity_Rule_4_OutEntry_2"><text>"validLeafObs"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_NumericPrecisionValidity" name="Numeric Precision Validity"><decisionTable id="Decision_NumericPrecisionValidity_Table" hitPolicy="FIRST"><input id="Decision_NumericPrecisionValidity_Input_1" label="Allow Decimal"><inputExpression id="Decision_NumericPrecisionValidity_InputExpr_1" typeRef="boolean"><text>allowDecimal</text></inputExpression></input><input id="Decision_NumericPrecisionValidity_Input_2" label="Value Numeric Has Fraction"><inputExpression id="Decision_NumericPrecisionValidity_InputExpr_2" typeRef="boolean"><text>valueNumericHasFraction</text></inputExpression></input><output id="Decision_NumericPrecisionValidity_Output_1" label="Precision Valid" name="precisionValid" typeRef="boolean" /><output id="Decision_NumericPrecisionValidity_Output_2" label="Reason Code" name="reasonCode" typeRef="string" /><rule id="Decision_NumericPrecisionValidity_Rule_1"><description>L195 short-circuits when allow_decimal is true</description><inputEntry id="Decision_NumericPrecisionValidity_Rule_1_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_NumericPrecisionValidity_Rule_1_InEntry_2"><text>-</text></inputEntry><outputEntry id="Decision_NumericPrecisionValidity_Rule_1_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_NumericPrecisionValidity_Rule_1_OutEntry_2"><text>"decimalAllowed"</text></outputEntry></rule><rule id="Decision_NumericPrecisionValidity_Rule_2"><description>Math.ceil(v)==v (L195)</description><inputEntry id="Decision_NumericPrecisionValidity_Rule_2_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_NumericPrecisionValidity_Rule_2_InEntry_2"><text>false</text></inputEntry><outputEntry id="Decision_NumericPrecisionValidity_Rule_2_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_NumericPrecisionValidity_Rule_2_OutEntry_2"><text>"integerValue"</text></outputEntry></rule><rule id="Decision_NumericPrecisionValidity_Rule_3"><description>Math.ceil(v)!=v (L195-201)</description><inputEntry id="Decision_NumericPrecisionValidity_Rule_3_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_NumericPrecisionValidity_Rule_3_InEntry_2"><text>true</text></inputEntry><outputEntry id="Decision_NumericPrecisionValidity_Rule_3_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_NumericPrecisionValidity_Rule_3_OutEntry_2"><text>"Obs.error.precision"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_NumericAbsoluteRangeValidity" name="Numeric Absolute Range Validity"><decisionTable id="Decision_NumericAbsoluteRangeValidity_Table" hitPolicy="FIRST"><input id="Decision_NumericAbsoluteRangeValidity_Input_1" label="Hi Absolute Set"><inputExpression id="Decision_NumericAbsoluteRangeValidity_InputExpr_1" typeRef="boolean"><text>hiAbsoluteSet</text></inputExpression></input><input id="Decision_NumericAbsoluteRangeValidity_Input_2" label="Low Absolute Set"><inputExpression id="Decision_NumericAbsoluteRangeValidity_InputExpr_2" typeRef="boolean"><text>lowAbsoluteSet</text></inputExpression></input><input id="Decision_NumericAbsoluteRangeValidity_Input_3" label="Value Numeric"><inputExpression id="Decision_NumericAbsoluteRangeValidity_InputExpr_3" typeRef="number"><text>valueNumeric</text></inputExpression></input><input id="Decision_NumericAbsoluteRangeValidity_Input_4" label="Hi Absolute"><inputExpression id="Decision_NumericAbsoluteRangeValidity_InputExpr_4" typeRef="number"><text>hiAbsolute</text></inputExpression></input><input id="Decision_NumericAbsoluteRangeValidity_Input_5" label="Low Absolute"><inputExpression id="Decision_NumericAbsoluteRangeValidity_InputExpr_5" typeRef="number"><text>lowAbsolute</text></inputExpression></input><output id="Decision_NumericAbsoluteRangeValidity_Output_1" label="Absolute Range Valid" name="absoluteRangeValid" typeRef="boolean" /><output id="Decision_NumericAbsoluteRangeValidity_Output_2" label="Reason Code" name="reasonCode" typeRef="string" /><rule id="Decision_NumericAbsoluteRangeValidity_Rule_1"><description>L309-316 -- modeled as a cross-variable comparison (valueNumeric &gt; hiAbsolute)</description><inputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_1_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_1_InEntry_3"><text>&gt; hiAbsolute</text></inputEntry><inputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_1_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_1_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_1_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_1_OutEntry_2"><text>"error.value.outOfRange.high"</text></outputEntry></rule><rule id="Decision_NumericAbsoluteRangeValidity_Rule_2"><description>L318-326 -- modeled as a cross-variable comparison (valueNumeric &lt; lowAbsolute)</description><inputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_2_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_2_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_2_InEntry_3"><text>&lt; lowAbsolute</text></inputEntry><inputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_2_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_2_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_2_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_2_OutEntry_2"><text>"error.value.outOfRange.low"</text></outputEntry></rule><rule id="Decision_NumericAbsoluteRangeValidity_Rule_3"><description>neither absolute bound violated</description><inputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_3_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_3_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_3_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_3_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_3_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_3_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_NumericAbsoluteRangeValidity_Rule_3_OutEntry_2"><text>"withinRange"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_NumericInterpretationClassification" name="Numeric Interpretation Classification"><decisionTable id="Decision_NumericInterpretationClassification_Table" hitPolicy="FIRST"><input id="Decision_NumericInterpretationClassification_Input_1" label="Value Numeric"><inputExpression id="Decision_NumericInterpretationClassification_InputExpr_1" typeRef="number"><text>valueNumeric</text></inputExpression></input><input id="Decision_NumericInterpretationClassification_Input_2" label="Hi Critical"><inputExpression id="Decision_NumericInterpretationClassification_InputExpr_2" typeRef="number"><text>hiCritical</text></inputExpression></input><input id="Decision_NumericInterpretationClassification_Input_3" label="Hi Normal"><inputExpression id="Decision_NumericInterpretationClassification_InputExpr_3" typeRef="number"><text>hiNormal</text></inputExpression></input><input id="Decision_NumericInterpretationClassification_Input_4" label="Low Critical"><inputExpression id="Decision_NumericInterpretationClassification_InputExpr_4" typeRef="number"><text>lowCritical</text></inputExpression></input><input id="Decision_NumericInterpretationClassification_Input_5" label="Low Normal"><inputExpression id="Decision_NumericInterpretationClassification_InputExpr_5" typeRef="number"><text>lowNormal</text></inputExpression></input><output id="Decision_NumericInterpretationClassification_Output_1" label="Interpretation" name="interpretation" typeRef="string" /><rule id="Decision_NumericInterpretationClassification_Rule_1"><description>L393-394 -- modeled as a FIRST-hit threshold ladder over valueNumeric against the four reference-range columns</description><inputEntry id="Decision_NumericInterpretationClassification_Rule_1_InEntry_1"><text>&gt;= hiCritical</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_1_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_1_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_1_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_NumericInterpretationClassification_Rule_1_OutEntry_1"><text>"CRITICALLY_HIGH"</text></outputEntry></rule><rule id="Decision_NumericInterpretationClassification_Rule_2"><description>L395-396 -- valueGtHiNormal was strictly "&gt;", preserved exactly (not loosened to "&gt;=")</description><inputEntry id="Decision_NumericInterpretationClassification_Rule_2_InEntry_1"><text>&gt; hiNormal</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_2_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_2_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_2_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_2_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_NumericInterpretationClassification_Rule_2_OutEntry_1"><text>"HIGH"</text></outputEntry></rule><rule id="Decision_NumericInterpretationClassification_Rule_3"><description>L397-398</description><inputEntry id="Decision_NumericInterpretationClassification_Rule_3_InEntry_1"><text>&lt;= lowCritical</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_3_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_3_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_3_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_3_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_NumericInterpretationClassification_Rule_3_OutEntry_1"><text>"CRITICALLY_LOW"</text></outputEntry></rule><rule id="Decision_NumericInterpretationClassification_Rule_4"><description>L399-400 -- valueLtLowNormal was strictly "&lt;", preserved exactly (not loosened to "&lt;=")</description><inputEntry id="Decision_NumericInterpretationClassification_Rule_4_InEntry_1"><text>&lt; lowNormal</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_4_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_4_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_4_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_4_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_NumericInterpretationClassification_Rule_4_OutEntry_1"><text>"LOW"</text></outputEntry></rule><rule id="Decision_NumericInterpretationClassification_Rule_5"><description>L401-402 (else branch)</description><inputEntry id="Decision_NumericInterpretationClassification_Rule_5_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_5_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_5_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_5_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_NumericInterpretationClassification_Rule_5_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_NumericInterpretationClassification_Rule_5_OutEntry_1"><text>"NORMAL"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_ConceptPreferredNameValidity" name="Concept Preferred Name Validity"><decisionTable id="Decision_ConceptPreferredNameValidity_Table" hitPolicy="FIRST"><input id="Decision_ConceptPreferredNameValidity_Input_1" label="Locale Preferred"><inputExpression id="Decision_ConceptPreferredNameValidity_InputExpr_1" typeRef="boolean"><text>localePreferred</text></inputExpression></input><input id="Decision_ConceptPreferredNameValidity_Input_2" label="Is Index Term"><inputExpression id="Decision_ConceptPreferredNameValidity_InputExpr_2" typeRef="boolean"><text>isIndexTerm</text></inputExpression></input><input id="Decision_ConceptPreferredNameValidity_Input_3" label="Is Short Name"><inputExpression id="Decision_ConceptPreferredNameValidity_InputExpr_3" typeRef="boolean"><text>isShortName</text></inputExpression></input><input id="Decision_ConceptPreferredNameValidity_Input_4" label="Voided"><inputExpression id="Decision_ConceptPreferredNameValidity_InputExpr_4" typeRef="boolean"><text>voided</text></inputExpression></input><output id="Decision_ConceptPreferredNameValidity_Output_1" label="Preferred Name Valid" name="preferredNameValid" typeRef="boolean" /><output id="Decision_ConceptPreferredNameValidity_Output_2" label="Reason Code" name="reasonCode" typeRef="string" /><rule id="Decision_ConceptPreferredNameValidity_Rule_1"><description>ConceptValidator L136-153 only guards preferred names</description><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_1_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_1_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_1_InEntry_4"><text>-</text></inputEntry><outputEntry id="Decision_ConceptPreferredNameValidity_Rule_1_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_ConceptPreferredNameValidity_Rule_1_OutEntry_2"><text>"notApplicable"</text></outputEntry></rule><rule id="Decision_ConceptPreferredNameValidity_Rule_2"><description>L138-141</description><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_2_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_2_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_2_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_2_InEntry_4"><text>-</text></inputEntry><outputEntry id="Decision_ConceptPreferredNameValidity_Rule_2_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_ConceptPreferredNameValidity_Rule_2_OutEntry_2"><text>"Concept.error.preferredName.is.indexTerm"</text></outputEntry></rule><rule id="Decision_ConceptPreferredNameValidity_Rule_3"><description>L142-145</description><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_3_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_3_InEntry_2"><text>false</text></inputEntry><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_3_InEntry_3"><text>true</text></inputEntry><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_3_InEntry_4"><text>-</text></inputEntry><outputEntry id="Decision_ConceptPreferredNameValidity_Rule_3_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_ConceptPreferredNameValidity_Rule_3_OutEntry_2"><text>"Concept.error.preferredName.is.shortName"</text></outputEntry></rule><rule id="Decision_ConceptPreferredNameValidity_Rule_4"><description>L146-149</description><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_4_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_4_InEntry_2"><text>false</text></inputEntry><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_4_InEntry_3"><text>false</text></inputEntry><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_4_InEntry_4"><text>true</text></inputEntry><outputEntry id="Decision_ConceptPreferredNameValidity_Rule_4_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_ConceptPreferredNameValidity_Rule_4_OutEntry_2"><text>"Concept.error.preferredName.is.voided"</text></outputEntry></rule><rule id="Decision_ConceptPreferredNameValidity_Rule_5"><description>passes all three checks</description><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_5_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_5_InEntry_2"><text>false</text></inputEntry><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_5_InEntry_3"><text>false</text></inputEntry><inputEntry id="Decision_ConceptPreferredNameValidity_Rule_5_InEntry_4"><text>false</text></inputEntry><outputEntry id="Decision_ConceptPreferredNameValidity_Rule_5_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_ConceptPreferredNameValidity_Rule_5_OutEntry_2"><text>"none"</text></outputEntry></rule></decisionTable></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_Concept_and_Observation_Validation_Diagram"><dmndi:DMNShape id="Decision_ObsValueRequiredByDatatype_Shape" dmnElementRef="Decision_ObsValueRequiredByDatatype"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_ObsGroupValueExclusivity_Shape" dmnElementRef="Decision_ObsGroupValueExclusivity"><dc:Bounds x="60" y="260" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_NumericPrecisionValidity_Shape" dmnElementRef="Decision_NumericPrecisionValidity"><dc:Bounds x="60" y="460" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_NumericAbsoluteRangeValidity_Shape" dmnElementRef="Decision_NumericAbsoluteRangeValidity"><dc:Bounds x="60" y="660" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_NumericInterpretationClassification_Shape" dmnElementRef="Decision_NumericInterpretationClassification"><dc:Bounds x="60" y="860" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_ConceptPreferredNameValidity_Shape" dmnElementRef="Decision_ConceptPreferredNameValidity"><dc:Bounds x="60" y="1060" width="220" height="90" /></dmndi:DMNShape></dmndi:DMNDiagram></dmndi:DMNDI></definitions>