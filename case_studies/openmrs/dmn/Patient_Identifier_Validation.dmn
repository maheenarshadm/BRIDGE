<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_Patient_Identifier_Validation" name="Patient Identifier Validation" namespace="urn:bridge:openmrs:Definitions_Patient_Identifier_Validation"><decision id="Decision_PreferredIdentifierRequirement" name="Preferred Identifier Requirement"><decisionTable id="Decision_PreferredIdentifierRequirement_Table" hitPolicy="FIRST"><input id="Decision_PreferredIdentifierRequirement_Input_1" label="Preferred Identifier Count"><inputExpression id="Decision_PreferredIdentifierRequirement_InputExpr_1" typeRef="number"><text>preferredIdentifierCount</text></inputExpression></input><input id="Decision_PreferredIdentifierRequirement_Input_2" label="Identifier Count"><inputExpression id="Decision_PreferredIdentifierRequirement_InputExpr_2" typeRef="number"><text>identifierCount</text></inputExpression></input><output id="Decision_PreferredIdentifierRequirement_Output_1" label="Preferred Identifier Valid" name="preferredIdentifierValid" typeRef="boolean" /><output id="Decision_PreferredIdentifierRequirement_Output_2" label="Reason Code" name="reasonCode" typeRef="string" /><rule id="Decision_PreferredIdentifierRequirement_Rule_1"><description>PatientValidator L87-90 -- exposed as a COUNT(identifiers WHERE preferred=true) &gt;= 1</description><inputEntry id="Decision_PreferredIdentifierRequirement_Rule_1_InEntry_1"><text>&gt;= 1</text></inputEntry><inputEntry id="Decision_PreferredIdentifierRequirement_Rule_1_InEntry_2"><text>-</text></inputEntry><outputEntry id="Decision_PreferredIdentifierRequirement_Rule_1_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_PreferredIdentifierRequirement_Rule_1_OutEntry_2"><text>"preferredChosen"</text></outputEntry></rule><rule id="Decision_PreferredIdentifierRequirement_Rule_2"><description>PatientValidator L92 (size()!=1 short-circuits)</description><inputEntry id="Decision_PreferredIdentifierRequirement_Rule_2_InEntry_1"><text>0</text></inputEntry><inputEntry id="Decision_PreferredIdentifierRequirement_Rule_2_InEntry_2"><text>1</text></inputEntry><outputEntry id="Decision_PreferredIdentifierRequirement_Rule_2_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_PreferredIdentifierRequirement_Rule_2_OutEntry_2"><text>"singleIdentifierExempt"</text></outputEntry></rule><rule id="Decision_PreferredIdentifierRequirement_Rule_3"><description>PatientValidator L92-94</description><inputEntry id="Decision_PreferredIdentifierRequirement_Rule_3_InEntry_1"><text>0</text></inputEntry><inputEntry id="Decision_PreferredIdentifierRequirement_Rule_3_InEntry_2"><text>!= 1</text></inputEntry><outputEntry id="Decision_PreferredIdentifierRequirement_Rule_3_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_PreferredIdentifierRequirement_Rule_3_OutEntry_2"><text>"error.preferredIdentifier"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_IdentifierLocationRequirement" name="Identifier Location Requirement"><decisionTable id="Decision_IdentifierLocationRequirement_Table" hitPolicy="FIRST"><input id="Decision_IdentifierLocationRequirement_Input_1" label="Location Set"><inputExpression id="Decision_IdentifierLocationRequirement_InputExpr_1" typeRef="boolean"><text>locationSet</text></inputExpression></input><input id="Decision_IdentifierLocationRequirement_Input_2" label="Location Behavior"><inputExpression id="Decision_IdentifierLocationRequirement_InputExpr_2" typeRef="string"><text>locationBehavior</text></inputExpression><inputValues id="Decision_IdentifierLocationRequirement_InputVals_2"><text>"REQUIRED","NOT_USED"</text></inputValues></input><output id="Decision_IdentifierLocationRequirement_Output_1" label="Location Requirement Valid" name="locationRequirementValid" typeRef="boolean" /><output id="Decision_IdentifierLocationRequirement_Output_2" label="Reason Code" name="reasonCode" typeRef="string" /><rule id="Decision_IdentifierLocationRequirement_Rule_1"><description>L97 location != null</description><inputEntry id="Decision_IdentifierLocationRequirement_Rule_1_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_IdentifierLocationRequirement_Rule_1_InEntry_2"><text>-</text></inputEntry><outputEntry id="Decision_IdentifierLocationRequirement_Rule_1_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_IdentifierLocationRequirement_Rule_1_OutEntry_2"><text>"locationProvided"</text></outputEntry></rule><rule id="Decision_IdentifierLocationRequirement_Rule_2"><description>L96-101 (null behavior defaults to REQUIRED)</description><inputEntry id="Decision_IdentifierLocationRequirement_Rule_2_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_IdentifierLocationRequirement_Rule_2_InEntry_2"><text>"REQUIRED"</text></inputEntry><outputEntry id="Decision_IdentifierLocationRequirement_Rule_2_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_IdentifierLocationRequirement_Rule_2_OutEntry_2"><text>"PatientIdentifier.location.null"</text></outputEntry></rule><rule id="Decision_IdentifierLocationRequirement_Rule_3"><description>L97 condition false when behavior is NOT_USED</description><inputEntry id="Decision_IdentifierLocationRequirement_Rule_3_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_IdentifierLocationRequirement_Rule_3_InEntry_2"><text>"NOT_USED"</text></inputEntry><outputEntry id="Decision_IdentifierLocationRequirement_Rule_3_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_IdentifierLocationRequirement_Rule_3_OutEntry_2"><text>"locationNotRequired"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_IdentifierUniquenessCheck" name="Identifier Uniqueness Check"><decisionTable id="Decision_IdentifierUniquenessCheck_Table" hitPolicy="FIRST"><input id="Decision_IdentifierUniquenessCheck_Input_1" label="Uniqueness Behavior"><inputExpression id="Decision_IdentifierUniquenessCheck_InputExpr_1" typeRef="string"><text>uniquenessBehavior</text></inputExpression><inputValues id="Decision_IdentifierUniquenessCheck_InputVals_1"><text>"UNIQUE","LOCATION","NON_UNIQUE"</text></inputValues></input><input id="Decision_IdentifierUniquenessCheck_Input_2" label="In Use By Another Patient"><inputExpression id="Decision_IdentifierUniquenessCheck_InputExpr_2" typeRef="boolean"><text>inUseByAnotherPatient</text></inputExpression></input><input id="Decision_IdentifierUniquenessCheck_Input_3" label="Duplicate Within Same Patient At Same Or Null Location"><inputExpression id="Decision_IdentifierUniquenessCheck_InputExpr_3" typeRef="boolean"><text>duplicateWithinSamePatient</text></inputExpression></input><output id="Decision_IdentifierUniquenessCheck_Output_1" label="Identifier Uniqueness Valid" name="identifierUniquenessValid" typeRef="boolean" /><output id="Decision_IdentifierUniquenessCheck_Output_2" label="Reason Code" name="reasonCode" typeRef="string" /><rule id="Decision_IdentifierUniquenessCheck_Rule_1"><description>L103-104 short-circuits the isIdentifierInUseByAnotherPatient check</description><inputEntry id="Decision_IdentifierUniquenessCheck_Rule_1_InEntry_1"><text>"NON_UNIQUE"</text></inputEntry><inputEntry id="Decision_IdentifierUniquenessCheck_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_IdentifierUniquenessCheck_Rule_1_InEntry_3"><text>-</text></inputEntry><outputEntry id="Decision_IdentifierUniquenessCheck_Rule_1_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_IdentifierUniquenessCheck_Rule_1_OutEntry_2"><text>"nonUniqueTypeExempt"</text></outputEntry></rule><rule id="Decision_IdentifierUniquenessCheck_Rule_2"><description>L103-110</description><inputEntry id="Decision_IdentifierUniquenessCheck_Rule_2_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_IdentifierUniquenessCheck_Rule_2_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_IdentifierUniquenessCheck_Rule_2_InEntry_3"><text>-</text></inputEntry><outputEntry id="Decision_IdentifierUniquenessCheck_Rule_2_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_IdentifierUniquenessCheck_Rule_2_OutEntry_2"><text>"IdentifierNotUniqueException"</text></outputEntry></rule><rule id="Decision_IdentifierUniquenessCheck_Rule_3"><description>L112-130</description><inputEntry id="Decision_IdentifierUniquenessCheck_Rule_3_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_IdentifierUniquenessCheck_Rule_3_InEntry_2"><text>false</text></inputEntry><inputEntry id="Decision_IdentifierUniquenessCheck_Rule_3_InEntry_3"><text>true</text></inputEntry><outputEntry id="Decision_IdentifierUniquenessCheck_Rule_3_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_IdentifierUniquenessCheck_Rule_3_OutEntry_2"><text>"DuplicateIdentifierException"</text></outputEntry></rule><rule id="Decision_IdentifierUniquenessCheck_Rule_4"><description>no matching identifier found</description><inputEntry id="Decision_IdentifierUniquenessCheck_Rule_4_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_IdentifierUniquenessCheck_Rule_4_InEntry_2"><text>false</text></inputEntry><inputEntry id="Decision_IdentifierUniquenessCheck_Rule_4_InEntry_3"><text>false</text></inputEntry><outputEntry id="Decision_IdentifierUniquenessCheck_Rule_4_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_IdentifierUniquenessCheck_Rule_4_OutEntry_2"><text>"unique"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_IdentifierFormatAndCheckDigitValidity" name="Identifier Format Validity"><decisionTable id="Decision_IdentifierFormatAndCheckDigitValidity_Table" hitPolicy="FIRST"><input id="Decision_IdentifierFormatAndCheckDigitValidity_Input_1" label="Identifier Blank"><inputExpression id="Decision_IdentifierFormatAndCheckDigitValidity_InputExpr_1" typeRef="boolean"><text>identifierBlank</text></inputExpression></input><input id="Decision_IdentifierFormatAndCheckDigitValidity_Input_2" label="Format Set"><inputExpression id="Decision_IdentifierFormatAndCheckDigitValidity_InputExpr_2" typeRef="boolean"><text>formatSet</text></inputExpression></input><input id="Decision_IdentifierFormatAndCheckDigitValidity_Input_3" label="Identifier Matches Format"><inputExpression id="Decision_IdentifierFormatAndCheckDigitValidity_InputExpr_3" typeRef="boolean"><text>identifierMatchesFormat</text></inputExpression></input><output id="Decision_IdentifierFormatAndCheckDigitValidity_Output_1" label="Identifier Format Valid" name="identifierFormatValid" typeRef="boolean" /><output id="Decision_IdentifierFormatAndCheckDigitValidity_Output_2" label="Reason Code" name="reasonCode" typeRef="string" /><rule id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_1"><description>L156-158,191-193,226-228</description><inputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_1_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_1_InEntry_3"><text>-</text></inputEntry><outputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_1_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_1_OutEntry_2"><text>"PatientIdentifier.error.nullOrBlank"</text></outputEntry></rule><rule id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_2"><description>checkIdentifierAgainstFormat L200-205</description><inputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_2_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_2_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_2_InEntry_3"><text>false</text></inputEntry><outputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_2_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_2_OutEntry_2"><text>"InvalidIdentifierFormatException"</text></outputEntry></rule><rule id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_3"><description>passes format check</description><inputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_3_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_3_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_3_InEntry_3"><text>true</text></inputEntry><outputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_3_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_3_OutEntry_2"><text>"none"</text></outputEntry></rule><rule id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_4"><description>no format configured (L160-166)</description><inputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_4_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_4_InEntry_2"><text>false</text></inputEntry><inputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_4_InEntry_3"><text>-</text></inputEntry><outputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_4_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_IdentifierFormatAndCheckDigitValidity_Rule_4_OutEntry_2"><text>"none"</text></outputEntry></rule></decisionTable></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_Patient_Identifier_Validation_Diagram"><dmndi:DMNShape id="Decision_PreferredIdentifierRequirement_Shape" dmnElementRef="Decision_PreferredIdentifierRequirement"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_IdentifierLocationRequirement_Shape" dmnElementRef="Decision_IdentifierLocationRequirement"><dc:Bounds x="60" y="260" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_IdentifierUniquenessCheck_Shape" dmnElementRef="Decision_IdentifierUniquenessCheck"><dc:Bounds x="60" y="460" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_IdentifierFormatAndCheckDigitValidity_Shape" dmnElementRef="Decision_IdentifierFormatAndCheckDigitValidity"><dc:Bounds x="60" y="660" width="220" height="90" /></dmndi:DMNShape></dmndi:DMNDiagram></dmndi:DMNDI></definitions>