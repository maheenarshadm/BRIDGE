<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_Person_Demographics_Validation" name="Person Demographics Validation" namespace="urn:bridge:openmrs:Definitions_Person_Demographics_Validation"><decision id="Decision_BirthdateValidity" name="Birthdate Validity"><decisionTable id="Decision_BirthdateValidity_Table" hitPolicy="FIRST"><input id="Decision_BirthdateValidity_Input_1" label="Birthdate"><inputExpression id="Decision_BirthdateValidity_InputExpr_1" typeRef="date"><text>birthdate</text></inputExpression></input><input id="Decision_BirthdateValidity_Input_2" label="Evaluation Time"><inputExpression id="Decision_BirthdateValidity_InputExpr_2" typeRef="date"><text>evaluationTime</text></inputExpression></input><input id="Decision_BirthdateValidity_Input_3" label="Years Since Birthdate"><inputExpression id="Decision_BirthdateValidity_InputExpr_3" typeRef="number"><text>yearsSinceBirthdate</text></inputExpression></input><output id="Decision_BirthdateValidity_Output_1" label="Birthdate Valid" name="birthdateValid" typeRef="boolean" /><output id="Decision_BirthdateValidity_Output_2" label="Reason Code" name="reasonCode" typeRef="string" /><rule id="Decision_BirthdateValidity_Rule_1"><description>rejectIfFutureDate on birthdate (L193-197) -- modeled as a date comparison against an explicit evaluationTime scenario parameter</description><inputEntry id="Decision_BirthdateValidity_Rule_1_InEntry_1"><text>&gt; evaluationTime</text></inputEntry><inputEntry id="Decision_BirthdateValidity_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_BirthdateValidity_Rule_1_InEntry_3"><text>-</text></inputEntry><outputEntry id="Decision_BirthdateValidity_Rule_1_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_BirthdateValidity_Rule_1_OutEntry_2"><text>"birthdate.future"</text></outputEntry></rule><rule id="Decision_BirthdateValidity_Rule_2"><description>rejectDateIfBefore140YearsAgo (L199-213)</description><inputEntry id="Decision_BirthdateValidity_Rule_2_InEntry_1"><text>&lt;= evaluationTime</text></inputEntry><inputEntry id="Decision_BirthdateValidity_Rule_2_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_BirthdateValidity_Rule_2_InEntry_3"><text>&gt; 140</text></inputEntry><outputEntry id="Decision_BirthdateValidity_Rule_2_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_BirthdateValidity_Rule_2_OutEntry_2"><text>"birthdate.olderThan140Years"</text></outputEntry></rule><rule id="Decision_BirthdateValidity_Rule_3"><description>passes both checks</description><inputEntry id="Decision_BirthdateValidity_Rule_3_InEntry_1"><text>&lt;= evaluationTime</text></inputEntry><inputEntry id="Decision_BirthdateValidity_Rule_3_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_BirthdateValidity_Rule_3_InEntry_3"><text>&lt;= 140</text></inputEntry><outputEntry id="Decision_BirthdateValidity_Rule_3_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_BirthdateValidity_Rule_3_OutEntry_2"><text>"none"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_DeathRecordConsistency" name="Death Record Consistency"><decisionTable id="Decision_DeathRecordConsistency_Table" hitPolicy="FIRST"><input id="Decision_DeathRecordConsistency_Input_1" label="Dead"><inputExpression id="Decision_DeathRecordConsistency_InputExpr_1" typeRef="boolean"><text>dead</text></inputExpression></input><input id="Decision_DeathRecordConsistency_Input_2" label="Cause Of Death Set"><inputExpression id="Decision_DeathRecordConsistency_InputExpr_2" typeRef="boolean"><text>causeOfDeathSet</text></inputExpression></input><input id="Decision_DeathRecordConsistency_Input_3" label="Cause Of Death Non Coded Set"><inputExpression id="Decision_DeathRecordConsistency_InputExpr_3" typeRef="boolean"><text>causeOfDeathNonCodedSet</text></inputExpression></input><output id="Decision_DeathRecordConsistency_Output_1" label="Death Record Valid" name="deathRecordValid" typeRef="boolean" /><output id="Decision_DeathRecordConsistency_Output_2" label="Reason Code" name="reasonCode" typeRef="string" /><rule id="Decision_DeathRecordConsistency_Rule_1"><description>validateDeathCause only runs if dead (L146)</description><inputEntry id="Decision_DeathRecordConsistency_Rule_1_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_DeathRecordConsistency_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_DeathRecordConsistency_Rule_1_InEntry_3"><text>-</text></inputEntry><outputEntry id="Decision_DeathRecordConsistency_Rule_1_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_DeathRecordConsistency_Rule_1_OutEntry_2"><text>"notApplicable"</text></outputEntry></rule><rule id="Decision_DeathRecordConsistency_Rule_2"><description>both set (L147-148)</description><inputEntry id="Decision_DeathRecordConsistency_Rule_2_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_DeathRecordConsistency_Rule_2_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_DeathRecordConsistency_Rule_2_InEntry_3"><text>true</text></inputEntry><outputEntry id="Decision_DeathRecordConsistency_Rule_2_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_DeathRecordConsistency_Rule_2_OutEntry_2"><text>"Person.dead.shouldHaveOnlyOneCauseOfDeathOrCauseOfDeathNonCodedSet"</text></outputEntry></rule><rule id="Decision_DeathRecordConsistency_Rule_3"><description>neither set (L149-150)</description><inputEntry id="Decision_DeathRecordConsistency_Rule_3_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_DeathRecordConsistency_Rule_3_InEntry_2"><text>false</text></inputEntry><inputEntry id="Decision_DeathRecordConsistency_Rule_3_InEntry_3"><text>false</text></inputEntry><outputEntry id="Decision_DeathRecordConsistency_Rule_3_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_DeathRecordConsistency_Rule_3_OutEntry_2"><text>"Person.dead.causeOfDeathAndCauseOfDeathNonCodedNull"</text></outputEntry></rule><rule id="Decision_DeathRecordConsistency_Rule_4"><description>exactly one set</description><inputEntry id="Decision_DeathRecordConsistency_Rule_4_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_DeathRecordConsistency_Rule_4_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_DeathRecordConsistency_Rule_4_InEntry_3"><text>false</text></inputEntry><outputEntry id="Decision_DeathRecordConsistency_Rule_4_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_DeathRecordConsistency_Rule_4_OutEntry_2"><text>"codedCauseOnly"</text></outputEntry></rule><rule id="Decision_DeathRecordConsistency_Rule_5"><description>exactly one set</description><inputEntry id="Decision_DeathRecordConsistency_Rule_5_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_DeathRecordConsistency_Rule_5_InEntry_2"><text>false</text></inputEntry><inputEntry id="Decision_DeathRecordConsistency_Rule_5_InEntry_3"><text>true</text></inputEntry><outputEntry id="Decision_DeathRecordConsistency_Rule_5_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_DeathRecordConsistency_Rule_5_OutEntry_2"><text>"nonCodedCauseOnly"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_DeathDateConsistencyViolations" name="Death Date Consistency Violations"><decisionTable id="Decision_DeathDateConsistencyViolations_Table" hitPolicy="COLLECT"><input id="Decision_DeathDateConsistencyViolations_Input_1" label="Death Date Set"><inputExpression id="Decision_DeathDateConsistencyViolations_InputExpr_1" typeRef="boolean"><text>deathDateSet</text></inputExpression></input><input id="Decision_DeathDateConsistencyViolations_Input_2" label="Death Date"><inputExpression id="Decision_DeathDateConsistencyViolations_InputExpr_2" typeRef="date"><text>deathDate</text></inputExpression></input><input id="Decision_DeathDateConsistencyViolations_Input_3" label="Evaluation Time"><inputExpression id="Decision_DeathDateConsistencyViolations_InputExpr_3" typeRef="date"><text>evaluationTime</text></inputExpression></input><input id="Decision_DeathDateConsistencyViolations_Input_4" label="Birthdate"><inputExpression id="Decision_DeathDateConsistencyViolations_InputExpr_4" typeRef="date"><text>birthdate</text></inputExpression></input><output id="Decision_DeathDateConsistencyViolations_Output_1" label="Violation Reason" name="violationReasons" typeRef="string" /><rule id="Decision_DeathDateConsistencyViolations_Rule_1"><description>rejectIfFutureDate on deathDate (L179,193-197) -- modeled as a date comparison; verified: no return before the before-birthdate check below, so both can fire on the same deathDate</description><inputEntry id="Decision_DeathDateConsistencyViolations_Rule_1_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_DeathDateConsistencyViolations_Rule_1_InEntry_2"><text>&gt; evaluationTime</text></inputEntry><inputEntry id="Decision_DeathDateConsistencyViolations_Rule_1_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_DeathDateConsistencyViolations_Rule_1_InEntry_4"><text>-</text></inputEntry><outputEntry id="Decision_DeathDateConsistencyViolations_Rule_1_OutEntry_1"><text>"error.date.future"</text></outputEntry></rule><rule id="Decision_DeathDateConsistencyViolations_Rule_2"><description>rejectDeathDateIfBeforeBirthDate (L183,222-226) -- modeled as a cross-variable date comparison against the sibling birthdate input; independent of the future check, no return between them</description><inputEntry id="Decision_DeathDateConsistencyViolations_Rule_2_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_DeathDateConsistencyViolations_Rule_2_InEntry_2"><text>&lt; birthdate</text></inputEntry><inputEntry id="Decision_DeathDateConsistencyViolations_Rule_2_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_DeathDateConsistencyViolations_Rule_2_InEntry_4"><text>-</text></inputEntry><outputEntry id="Decision_DeathDateConsistencyViolations_Rule_2_OutEntry_1"><text>"error.deathdate.before.birthdate"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_DeathDateConsistency" name="Death Date Consistency"><variable id="Decision_DeathDateConsistency_Var" name="deathDateValid" typeRef="boolean" /><informationRequirement id="InfoReq_1"><requiredDecision href="#Decision_DeathDateConsistencyViolations" /></informationRequirement><literalExpression id="Decision_DeathDateConsistency_Expr"><text>count(violationReasons) = 0</text></literalExpression></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_Person_Demographics_Validation_Diagram"><dmndi:DMNShape id="Decision_BirthdateValidity_Shape" dmnElementRef="Decision_BirthdateValidity"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_DeathRecordConsistency_Shape" dmnElementRef="Decision_DeathRecordConsistency"><dc:Bounds x="60" y="260" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_DeathDateConsistencyViolations_Shape" dmnElementRef="Decision_DeathDateConsistencyViolations"><dc:Bounds x="60" y="460" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_DeathDateConsistency_Shape" dmnElementRef="Decision_DeathDateConsistency"><dc:Bounds x="370" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNEdge id="Edge_1" dmnElementRef="InfoReq_1"><di:waypoint x="280" y="505" /><di:waypoint x="370" y="105" /></dmndi:DMNEdge></dmndi:DMNDiagram></dmndi:DMNDI></definitions>