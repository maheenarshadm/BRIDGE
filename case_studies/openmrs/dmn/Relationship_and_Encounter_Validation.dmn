<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_Relationship_and_Encounter_Validation" name="Relationship and Encounter Validation" namespace="urn:bridge:openmrs:Definitions_Relationship_and_Encounter_Validation"><decision id="Decision_RelationshipDateValidityViolations" name="Relationship Date Validity Violations"><decisionTable id="Decision_RelationshipDateValidityViolations_Table" hitPolicy="COLLECT"><input id="Decision_RelationshipDateValidityViolations_Input_1" label="Start Date Set"><inputExpression id="Decision_RelationshipDateValidityViolations_InputExpr_1" typeRef="boolean"><text>startDateSet</text></inputExpression></input><input id="Decision_RelationshipDateValidityViolations_Input_2" label="End Date Set"><inputExpression id="Decision_RelationshipDateValidityViolations_InputExpr_2" typeRef="boolean"><text>endDateSet</text></inputExpression></input><input id="Decision_RelationshipDateValidityViolations_Input_3" label="Start Date"><inputExpression id="Decision_RelationshipDateValidityViolations_InputExpr_3" typeRef="date"><text>startDate</text></inputExpression></input><input id="Decision_RelationshipDateValidityViolations_Input_4" label="Evaluation Time"><inputExpression id="Decision_RelationshipDateValidityViolations_InputExpr_4" typeRef="date"><text>evaluationTime</text></inputExpression></input><input id="Decision_RelationshipDateValidityViolations_Input_5" label="End Date"><inputExpression id="Decision_RelationshipDateValidityViolations_InputExpr_5" typeRef="date"><text>endDate</text></inputExpression></input><output id="Decision_RelationshipDateValidityViolations_Output_1" label="Violation Reason" name="violationReasons" typeRef="string" /><rule id="Decision_RelationshipDateValidityViolations_Rule_1"><description>L54-58 -- modeled as a cross-variable date comparison (startDate &gt; endDate); verified against the source: no return after this check</description><inputEntry id="Decision_RelationshipDateValidityViolations_Rule_1_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_RelationshipDateValidityViolations_Rule_1_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_RelationshipDateValidityViolations_Rule_1_InEntry_3"><text>&gt; endDate</text></inputEntry><inputEntry id="Decision_RelationshipDateValidityViolations_Rule_1_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_RelationshipDateValidityViolations_Rule_1_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_RelationshipDateValidityViolations_Rule_1_OutEntry_1"><text>"Relationship.InvalidEndDate.error"</text></outputEntry></rule><rule id="Decision_RelationshipDateValidityViolations_Rule_2"><description>L60-64 -- modeled as a date comparison against an explicit evaluationTime; verified: independent of the end-date check, no return between them</description><inputEntry id="Decision_RelationshipDateValidityViolations_Rule_2_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_RelationshipDateValidityViolations_Rule_2_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_RelationshipDateValidityViolations_Rule_2_InEntry_3"><text>&gt; evaluationTime</text></inputEntry><inputEntry id="Decision_RelationshipDateValidityViolations_Rule_2_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_RelationshipDateValidityViolations_Rule_2_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_RelationshipDateValidityViolations_Rule_2_OutEntry_1"><text>"error.date.future"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_RelationshipDateValidity" name="Relationship Date Validity"><variable id="Decision_RelationshipDateValidity_Var" name="relationshipDatesValid" typeRef="boolean" /><informationRequirement id="InfoReq_1"><requiredDecision href="#Decision_RelationshipDateValidityViolations" /></informationRequirement><literalExpression id="Decision_RelationshipDateValidity_Expr"><text>count(violationReasons) = 0</text></literalExpression></decision><decision id="Decision_EncounterDatetimeValidityViolations" name="Encounter Datetime Validity Violations"><decisionTable id="Decision_EncounterDatetimeValidityViolations_Table" hitPolicy="COLLECT"><input id="Decision_EncounterDatetimeValidityViolations_Input_1" label="Visit Patient Id"><inputExpression id="Decision_EncounterDatetimeValidityViolations_InputExpr_1" typeRef="string"><text>visitPatientId</text></inputExpression></input><input id="Decision_EncounterDatetimeValidityViolations_Input_2" label="Encounter Patient Id"><inputExpression id="Decision_EncounterDatetimeValidityViolations_InputExpr_2" typeRef="string"><text>encounterPatientId</text></inputExpression></input><input id="Decision_EncounterDatetimeValidityViolations_Input_3" label="Encounter Datetime"><inputExpression id="Decision_EncounterDatetimeValidityViolations_InputExpr_3" typeRef="date"><text>encounterDatetime</text></inputExpression></input><input id="Decision_EncounterDatetimeValidityViolations_Input_4" label="Evaluation Time"><inputExpression id="Decision_EncounterDatetimeValidityViolations_InputExpr_4" typeRef="date"><text>evaluationTime</text></inputExpression></input><input id="Decision_EncounterDatetimeValidityViolations_Input_5" label="Visit Set"><inputExpression id="Decision_EncounterDatetimeValidityViolations_InputExpr_5" typeRef="boolean"><text>visitSet</text></inputExpression></input><input id="Decision_EncounterDatetimeValidityViolations_Input_6" label="Visit Start Datetime"><inputExpression id="Decision_EncounterDatetimeValidityViolations_InputExpr_6" typeRef="date"><text>visitStartDatetime</text></inputExpression></input><input id="Decision_EncounterDatetimeValidityViolations_Input_7" label="Visit Stop Datetime"><inputExpression id="Decision_EncounterDatetimeValidityViolations_InputExpr_7" typeRef="date"><text>visitStopDatetime</text></inputExpression></input><output id="Decision_EncounterDatetimeValidityViolations_Output_1" label="Violation Reason" name="violationReasons" typeRef="string" /><rule id="Decision_EncounterDatetimeValidityViolations_Rule_1"><description>L82-85 -- modeled as a ID-inequality comparison (encounterPatientId != visitPatientId); verified: no return after this check</description><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_1_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_1_InEntry_2"><text>!= visitPatientId</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_1_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_1_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_1_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_1_InEntry_6"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_1_InEntry_7"><text>-</text></inputEntry><outputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_1_OutEntry_1"><text>"Encounter.visit.patients.dontMatch"</text></outputEntry></rule><rule id="Decision_EncounterDatetimeValidityViolations_Rule_2"><description>L89-92 -- modeled as a date comparison against an explicit evaluationTime; verified: independent of the visit-mismatch check and the two visit-range checks</description><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_2_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_2_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_2_InEntry_3"><text>&gt; evaluationTime</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_2_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_2_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_2_InEntry_6"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_2_InEntry_7"><text>-</text></inputEntry><outputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_2_OutEntry_1"><text>"Encounter.datetimeShouldBeBeforeCurrent"</text></outputEntry></rule><rule id="Decision_EncounterDatetimeValidityViolations_Rule_3"><description>L96-99 -- modeled as a cross-variable date comparison; verified: can co-fire with the future-date check and the visit-mismatch check</description><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_3_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_3_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_3_InEntry_3"><text>&lt; visitStartDatetime</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_3_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_3_InEntry_5"><text>true</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_3_InEntry_6"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_3_InEntry_7"><text>-</text></inputEntry><outputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_3_OutEntry_1"><text>"Encounter.datetimeShouldBeInVisitDatesRange"</text></outputEntry></rule><rule id="Decision_EncounterDatetimeValidityViolations_Rule_4"><description>L101-104 -- modeled as a cross-variable date comparison; verified: same message id as the row above but a genuinely distinct real check</description><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_4_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_4_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_4_InEntry_3"><text>&gt; visitStopDatetime</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_4_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_4_InEntry_5"><text>true</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_4_InEntry_6"><text>-</text></inputEntry><inputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_4_InEntry_7"><text>-</text></inputEntry><outputEntry id="Decision_EncounterDatetimeValidityViolations_Rule_4_OutEntry_1"><text>"Encounter.datetimeShouldBeInVisitDatesRange"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_EncounterDatetimeValidity" name="Encounter Datetime Validity"><variable id="Decision_EncounterDatetimeValidity_Var" name="encounterDatetimeValid" typeRef="boolean" /><informationRequirement id="InfoReq_2"><requiredDecision href="#Decision_EncounterDatetimeValidityViolations" /></informationRequirement><literalExpression id="Decision_EncounterDatetimeValidity_Expr"><text>count(violationReasons) = 0</text></literalExpression></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_Relationship_and_Encounter_Validation_Diagram"><dmndi:DMNShape id="Decision_RelationshipDateValidityViolations_Shape" dmnElementRef="Decision_RelationshipDateValidityViolations"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_RelationshipDateValidity_Shape" dmnElementRef="Decision_RelationshipDateValidity"><dc:Bounds x="370" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_EncounterDatetimeValidityViolations_Shape" dmnElementRef="Decision_EncounterDatetimeValidityViolations"><dc:Bounds x="60" y="260" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_EncounterDatetimeValidity_Shape" dmnElementRef="Decision_EncounterDatetimeValidity"><dc:Bounds x="370" y="260" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNEdge id="Edge_1" dmnElementRef="InfoReq_1"><di:waypoint x="280" y="105" /><di:waypoint x="370" y="105" /></dmndi:DMNEdge><dmndi:DMNEdge id="Edge_2" dmnElementRef="InfoReq_2"><di:waypoint x="280" y="305" /><di:waypoint x="370" y="305" /></dmndi:DMNEdge></dmndi:DMNDiagram></dmndi:DMNDI></definitions>