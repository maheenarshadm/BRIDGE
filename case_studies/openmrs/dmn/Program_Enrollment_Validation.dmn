<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_Program_Enrollment_Validation" name="Program Enrollment Validation" namespace="urn:bridge:openmrs:Definitions_Program_Enrollment_Validation"><decision id="Decision_ProgramEnrollmentDateConsistencyViolations" name="Program Enrollment Date Consistency Violations"><decisionTable id="Decision_ProgramEnrollmentDateConsistencyViolations_Table" hitPolicy="COLLECT"><input id="Decision_ProgramEnrollmentDateConsistencyViolations_Input_1" label="Date Enrolled"><inputExpression id="Decision_ProgramEnrollmentDateConsistencyViolations_InputExpr_1" typeRef="date"><text>dateEnrolled</text></inputExpression></input><input id="Decision_ProgramEnrollmentDateConsistencyViolations_Input_2" label="Evaluation Time"><inputExpression id="Decision_ProgramEnrollmentDateConsistencyViolations_InputExpr_2" typeRef="date"><text>evaluationTime</text></inputExpression></input><input id="Decision_ProgramEnrollmentDateConsistencyViolations_Input_3" label="Date Completed Set"><inputExpression id="Decision_ProgramEnrollmentDateConsistencyViolations_InputExpr_3" typeRef="boolean"><text>dateCompletedSet</text></inputExpression></input><input id="Decision_ProgramEnrollmentDateConsistencyViolations_Input_4" label="Date Completed"><inputExpression id="Decision_ProgramEnrollmentDateConsistencyViolations_InputExpr_4" typeRef="date"><text>dateCompleted</text></inputExpression></input><output id="Decision_ProgramEnrollmentDateConsistencyViolations_Output_1" label="Violation Reason" name="violationReasons" typeRef="string" /><rule id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_1"><description>L100-102 -- modeled as a date comparison against an explicit evaluationTime; verified: no return after this check; independent of the two below</description><inputEntry id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_1_InEntry_1"><text>&gt; evaluationTime</text></inputEntry><inputEntry id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_1_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_1_InEntry_4"><text>-</text></inputEntry><outputEntry id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_1_OutEntry_1"><text>"error.patientProgram.enrolledDateDateCannotBeInFuture"</text></outputEntry></rule><rule id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_2"><description>L104-106 -- modeled as a date comparison; verified: no return before or after; a program can have BOTH its enrollment date AND completion date in the future simultaneously</description><inputEntry id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_2_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_2_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_2_InEntry_3"><text>true</text></inputEntry><inputEntry id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_2_InEntry_4"><text>&gt; evaluationTime</text></inputEntry><outputEntry id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_2_OutEntry_1"><text>"error.patientProgram.completionDateCannotBeInFuture"</text></outputEntry></rule><rule id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_3"><description>L108-112 -- modeled as a cross-variable date comparison (dateCompleted &lt; dateEnrolled); verified: runs unconditionally after the two checks above; all three can co-fire on the same PatientProgram</description><inputEntry id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_3_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_3_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_3_InEntry_3"><text>true</text></inputEntry><inputEntry id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_3_InEntry_4"><text>&lt; dateEnrolled</text></inputEntry><outputEntry id="Decision_ProgramEnrollmentDateConsistencyViolations_Rule_3_OutEntry_1"><text>"error.patientProgram.enrolledDateShouldBeBeforecompletionDate"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_ProgramEnrollmentDateConsistency" name="Program Enrollment Date Consistency"><variable id="Decision_ProgramEnrollmentDateConsistency_Var" name="enrollmentDatesValid" typeRef="boolean" /><informationRequirement id="InfoReq_1"><requiredDecision href="#Decision_ProgramEnrollmentDateConsistencyViolations" /></informationRequirement><literalExpression id="Decision_ProgramEnrollmentDateConsistency_Expr"><text>count(violationReasons) = 0</text></literalExpression></decision><decision id="Decision_PatientStateDateValidity" name="Patient State Date Validity"><decisionTable id="Decision_PatientStateDateValidity_Table" hitPolicy="FIRST"><input id="Decision_PatientStateDateValidity_Input_1" label="Start Date Set"><inputExpression id="Decision_PatientStateDateValidity_InputExpr_1" typeRef="boolean"><text>startDateSet</text></inputExpression></input><input id="Decision_PatientStateDateValidity_Input_2" label="End Date Set"><inputExpression id="Decision_PatientStateDateValidity_InputExpr_2" typeRef="boolean"><text>endDateSet</text></inputExpression></input><input id="Decision_PatientStateDateValidity_Input_3" label="Start Date"><inputExpression id="Decision_PatientStateDateValidity_InputExpr_3" typeRef="date"><text>startDate</text></inputExpression></input><input id="Decision_PatientStateDateValidity_Input_4" label="End Date"><inputExpression id="Decision_PatientStateDateValidity_InputExpr_4" typeRef="date"><text>endDate</text></inputExpression></input><output id="Decision_PatientStateDateValidity_Output_1" label="Patient State Dates Valid" name="patientStateDatesValid" typeRef="boolean" /><output id="Decision_PatientStateDateValidity_Output_2" label="Reason Code" name="reasonCode" typeRef="string" /><rule id="Decision_PatientStateDateValidity_Rule_1"><description>L169-171 -- modeled as a cross-variable date comparison (endDate &lt; startDate), for the normal case where both dates are set</description><inputEntry id="Decision_PatientStateDateValidity_Rule_1_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_PatientStateDateValidity_Rule_1_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_PatientStateDateValidity_Rule_1_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_PatientStateDateValidity_Rule_1_InEntry_4"><text>&lt; startDate</text></inputEntry><outputEntry id="Decision_PatientStateDateValidity_Rule_1_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_PatientStateDateValidity_Rule_1_OutEntry_2"><text>"PatientState.error.endDateCannotBeBeforeStartDate"</text></outputEntry></rule><rule id="Decision_PatientStateDateValidity_Rule_2"><description>L169 (null start treated as earliest by compareWithNullAsLatest) -- deliberately kept boolean-keyed rather than exposed as a comparison: startDate is null here, so there is no real date to compare endDate against; this row encodes a Java comparator quirk, not a graduated threshold</description><inputEntry id="Decision_PatientStateDateValidity_Rule_2_InEntry_1"><text>false</text></inputEntry><inputEntry id="Decision_PatientStateDateValidity_Rule_2_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_PatientStateDateValidity_Rule_2_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_PatientStateDateValidity_Rule_2_InEntry_4"><text>-</text></inputEntry><outputEntry id="Decision_PatientStateDateValidity_Rule_2_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_PatientStateDateValidity_Rule_2_OutEntry_2"><text>"PatientState.error.endDateCannotBeBeforeStartDate"</text></outputEntry></rule><rule id="Decision_PatientStateDateValidity_Rule_3"><description>end after start</description><inputEntry id="Decision_PatientStateDateValidity_Rule_3_InEntry_1"><text>true</text></inputEntry><inputEntry id="Decision_PatientStateDateValidity_Rule_3_InEntry_2"><text>true</text></inputEntry><inputEntry id="Decision_PatientStateDateValidity_Rule_3_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_PatientStateDateValidity_Rule_3_InEntry_4"><text>&gt;= startDate</text></inputEntry><outputEntry id="Decision_PatientStateDateValidity_Rule_3_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_PatientStateDateValidity_Rule_3_OutEntry_2"><text>"closedStateValid"</text></outputEntry></rule><rule id="Decision_PatientStateDateValidity_Rule_4"><description>no end date recorded yet</description><inputEntry id="Decision_PatientStateDateValidity_Rule_4_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_PatientStateDateValidity_Rule_4_InEntry_2"><text>false</text></inputEntry><inputEntry id="Decision_PatientStateDateValidity_Rule_4_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_PatientStateDateValidity_Rule_4_InEntry_4"><text>-</text></inputEntry><outputEntry id="Decision_PatientStateDateValidity_Rule_4_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_PatientStateDateValidity_Rule_4_OutEntry_2"><text>"openEndedState"</text></outputEntry></rule></decisionTable></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_Program_Enrollment_Validation_Diagram"><dmndi:DMNShape id="Decision_ProgramEnrollmentDateConsistencyViolations_Shape" dmnElementRef="Decision_ProgramEnrollmentDateConsistencyViolations"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_ProgramEnrollmentDateConsistency_Shape" dmnElementRef="Decision_ProgramEnrollmentDateConsistency"><dc:Bounds x="370" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_PatientStateDateValidity_Shape" dmnElementRef="Decision_PatientStateDateValidity"><dc:Bounds x="60" y="260" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNEdge id="Edge_1" dmnElementRef="InfoReq_1"><di:waypoint x="280" y="105" /><di:waypoint x="370" y="105" /></dmndi:DMNEdge></dmndi:DMNDiagram></dmndi:DMNDI></definitions>